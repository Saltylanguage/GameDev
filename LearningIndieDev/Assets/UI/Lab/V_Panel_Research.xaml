<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../DesignSystem/FigmaNoesisPilotResources.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <DataTemplate x:Key="ResearchTemplate">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Ui.Text.WindowTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Ui.Text.Body}" TextWrapping="Wrap" Margin="0,12,0,24" />
            <Border Background="{DynamicResource Ui.Brush.Header}" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock Text="CATALOGUE PREVIEW" Foreground="{DynamicResource Ui.Brush.TextAccent}" FontWeight="Bold" />
                    <TextBlock Text="RULES / TRAITS / UNLOCKS" Foreground="{DynamicResource Ui.Brush.TextPrimary}" FontSize="20" Margin="0,8,0,4" />
                    <TextBlock Text="Research purchases are intentionally disabled until their persistence and economy helpers are ready." Style="{StaticResource Ui.Text.Body}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Ui.Brush.TextAccent}" FontWeight="Bold" Margin="0,24,0,0" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
