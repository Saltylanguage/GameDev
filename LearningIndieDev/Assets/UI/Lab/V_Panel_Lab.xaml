<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../DesignSystem/FigmaNoesisPilotResources.xaml" />
                <ResourceDictionary Source="V_Panel_Overview.xaml" />
                <ResourceDictionary Source="V_Panel_Research.xaml" />
                <ResourceDictionary Source="V_Panel_SpeciesArchive.xaml" />
                <ResourceDictionary Source="V_Panel_ExpeditionSetup.xaml" />
                <ResourceDictionary Source="V_Panel_Settings.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid Width="1280" Height="720" Background="{DynamicResource Ui.Brush.Canvas}" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="86" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource Ui.Brush.Header}" Padding="22,14" CornerRadius="8">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="GALAPAGOS LAB" Style="{StaticResource Ui.Text.WindowTitle}" />
                        <TextBlock Text="Permanent systems between evolutionary runs" Style="{StaticResource Ui.Text.Body}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="PROFILE" Foreground="{DynamicResource Ui.Brush.TextAccent}" FontWeight="Bold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ProfileName}" Foreground="{DynamicResource Ui.Brush.TextPrimary}" FontSize="16" HorizontalAlignment="Right" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource Ui.Brush.Window}" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="LAB DESKTOP" Foreground="{DynamicResource Ui.Brush.TextAccent}" FontWeight="Bold" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Features}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Command="{Binding OpenCommand}" Style="{StaticResource Ui.Button.Secondary}" Padding="12,10" MinHeight="42" Margin="0,0,0,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="{DynamicResource Ui.Brush.Header}" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                        <TextBlock Text="Select a window to inspect the current prototype surface." Style="{StaticResource Ui.Text.Body}" TextWrapping="Wrap" />
                    </Border>
                    <Button Content="RETURN TO MAIN MENU" Command="{Binding ReturnToMainMenuCommand}" Style="{StaticResource Ui.Button.Secondary}" Padding="12,10" MinHeight="42" Margin="0,18,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource Ui.Brush.Window}" CornerRadius="12" Padding="28">
                <Grid>
                    <ContentControl Visibility="{Binding OverviewVisibility}" Content="{Binding Overview}" ContentTemplate="{StaticResource OverviewTemplate}" />
                    <ContentControl Visibility="{Binding ResearchVisibility}" Content="{Binding Research}" ContentTemplate="{StaticResource ResearchTemplate}" />
                    <ContentControl Visibility="{Binding SpeciesArchiveVisibility}" Content="{Binding SpeciesArchive}" ContentTemplate="{StaticResource SpeciesArchiveTemplate}" />
                    <ContentControl Visibility="{Binding ExpeditionSetupVisibility}" Content="{Binding ExpeditionSetup}" ContentTemplate="{StaticResource ExpeditionSetupTemplate}" />
                    <ContentControl Visibility="{Binding SettingsVisibility}" Content="{Binding Settings}" ContentTemplate="{StaticResource SettingsTemplate}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Content="BACK TO OVERVIEW" Command="{Binding BackToOverviewCommand}" Style="{StaticResource Ui.Button.Secondary}" Padding="16,10" MinHeight="42" Margin="0,0,10,0" />
                        <Button Content="LAUNCH EXPEDITION" Command="{Binding LaunchExpeditionCommand}" IsEnabled="{Binding CanLaunchExpedition}" Style="{StaticResource Ui.Button.Primary}" Padding="16,10" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
