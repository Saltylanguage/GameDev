<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../DesignSystem/FigmaNoesisPilotResources.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <DataTemplate x:Key="SpeciesArchiveTemplate">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Ui.Text.WindowTitle}" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Ui.Text.Body}" TextWrapping="Wrap" Margin="0,12,0,24" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#FF234D3A" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="FERN" Foreground="White" FontSize="18" FontWeight="Bold" /><TextBlock Text="PLANT" Foreground="#FF8FE3A8" Margin="0,6,0,0" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#FF24415C" CornerRadius="8" Padding="14" Margin="4,0,4,0">
                    <StackPanel><TextBlock Text="HARE" Foreground="White" FontSize="18" FontWeight="Bold" /><TextBlock Text="HERBIVORE" Foreground="#FF9ED7FF" Margin="0,6,0,0" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#FF5A2D39" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                    <StackPanel><TextBlock Text="FOX" Foreground="White" FontSize="18" FontWeight="Bold" /><TextBlock Text="CARNIVORE" Foreground="#FFFF9D9D" Margin="0,6,0,0" /></StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Ui.Brush.TextAccent}" FontWeight="Bold" Margin="0,24,0,0" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
