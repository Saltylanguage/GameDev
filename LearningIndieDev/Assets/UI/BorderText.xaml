<Component
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:system="clr-namespace:System"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#FFE1E9ED"
  x:Name="BorderTextComponent" d:DataContext="MyStructure000 Data 01">
  <Component.Resources>    
    <SolidColorBrush x:Key="Brush" Color="#FFBB848E"/>
  </Component.Resources>       
  
  <Component.DynamicProperties>
<!--     
    <DynamicProperty Name="Color" Type="Brush" DefaultValue="{StaticResource Brush}"/>
    <DynamicProperty Name="CornerRadius" Type="Float" DefaultValue="1.0"/>
    <DynamicProperty Name="Text" Type="String" DefaultValue="Default Text"/> -->
    
  </Component.DynamicProperties>

  <Border x:Name="TextParentBorder" VerticalAlignment="Center" Padding="4,0,4,0" MinWidth="60" Background="{Binding Path=DynamicProperties[0], ElementName=BorderTextComponent}" BorderBrush="#FF000000" CornerRadius="16,16,16,16">  
    <TextBlock x:Name="Text" Text="Text" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" TextAlignment="Center"/>
  </Border>
</Component>