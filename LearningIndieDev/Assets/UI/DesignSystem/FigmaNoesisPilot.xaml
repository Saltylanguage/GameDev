<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FigmaNoesisPilotResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Ui.Brush.Canvas}">
        <Viewbox Stretch="Uniform">
            <Border Width="960"
                    Padding="{DynamicResource Ui.Padding.Window}"
                    Background="{DynamicResource Ui.Brush.Window}"
                    CornerRadius="{DynamicResource Ui.Radius.Window}">
                <StackPanel>
                    <TextBlock Text="FIGMA → NOESIS PILOT"
                               Style="{StaticResource Ui.Text.WindowTitle}" />
                    <TextBlock Text="One resource contract, two button styles, and three explicit sizes."
                               Style="{StaticResource Ui.Text.Body}"
                               Margin="0,8,0,24" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PRIMARY"
                                       Foreground="{DynamicResource Ui.Brush.TextAccent}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12" />
                            <Button Content="SMALL"
                                    Style="{StaticResource Ui.Button.Primary}"
                                    Padding="{StaticResource Ui.Padding.Button.Small}"
                                    MinHeight="36" />
                            <Button Content="MEDIUM"
                                    Style="{StaticResource Ui.Button.Primary}"
                                    Padding="{StaticResource Ui.Padding.Button.Medium}"
                                    MinHeight="44"
                                    Margin="0,12,0,0" />
                            <Button Content="LARGE"
                                    Style="{StaticResource Ui.Button.Primary}"
                                    Padding="{StaticResource Ui.Padding.Button.Large}"
                                    MinHeight="52"
                                    Margin="0,12,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SECONDARY"
                                       Foreground="{DynamicResource Ui.Brush.TextSecondary}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12" />
                            <Button Content="SMALL"
                                    Style="{StaticResource Ui.Button.Secondary}"
                                    Padding="{StaticResource Ui.Padding.Button.Small}"
                                    MinHeight="36" />
                            <Button Content="MEDIUM"
                                    Style="{StaticResource Ui.Button.Secondary}"
                                    Padding="{StaticResource Ui.Padding.Button.Medium}"
                                    MinHeight="44"
                                    Margin="0,12,0,0" />
                            <Button Content="LARGE"
                                    Style="{StaticResource Ui.Button.Secondary}"
                                    Padding="{StaticResource Ui.Padding.Button.Large}"
                                    MinHeight="52"
                                    Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Change a brush or radius in the resource dictionary and every consumer updates."
                               Style="{StaticResource Ui.Text.Body}"
                               Margin="0,24,0,0" />
                </StackPanel>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
