<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1920" d:DesignHeight="1080">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../ImageResources.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <SolidColorBrush x:Key="Menu.Ink" Color="#FF372C15" />
      <SolidColorBrush x:Key="Menu.Cream" Color="#FFFFF9E8" />
      <SolidColorBrush x:Key="Menu.WarmCream" Color="#FFFCEEC0" />
      <SolidColorBrush x:Key="Menu.Olive" Color="#FF84A340" />
      <SolidColorBrush x:Key="Menu.DarkOlive" Color="#FF59692F" />
      <SolidColorBrush x:Key="Menu.Lime" Color="#FFC5D370" />
      <SolidColorBrush x:Key="Menu.Pollen" Color="#FFFDCA47" />
      <SolidColorBrush x:Key="Menu.Coral" Color="#FFFF9770" />
    <LinearGradientBrush x:Key="Menu.LeftScrim" StartPoint="0,0.5" EndPoint="1,0.5">
      <GradientStop Color="#D9372C15" Offset="0" />
      <GradientStop Color="#B6372C15" Offset="0.30" />
      <GradientStop Color="#4D372C15" Offset="0.54" />
      <GradientStop Color="#00372C15" Offset="0.76" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Menu.PanelBackground" StartPoint="0.5,0" EndPoint="0.5,1">
      <GradientStop Color="#F8FFF9E8" Offset="0" />
      <GradientStop Color="#F4FCEEC0" Offset="1" />
    </LinearGradientBrush>

    <ControlTemplate x:Key="Menu.PrimaryButtonTemplate" TargetType="Button">
      <Grid>
        <Border x:Name="FocusRing"
                Margin="-4"
                BorderBrush="{StaticResource Menu.Pollen}"
                BorderThickness="3"
                CornerRadius="11"
                Opacity="0" />
        <Border x:Name="Surface"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8">
          <Grid>
            <Border Width="6"
                    HorizontalAlignment="Left"
                    Background="{StaticResource Menu.Pollen}"
                    CornerRadius="8,0,0,8"
                    IsHitTestVisible="False" />
            <Border Width="46"
                    HorizontalAlignment="Right"
                    Background="#24FFFFFF"
                    CornerRadius="0,8,8,0"
                    IsHitTestVisible="False" />
            <Border BorderBrush="#55FFFFFF"
                    BorderThickness="1,1,1,0"
                    CornerRadius="7"
                    IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                              TextElement.FontSize="{TemplateBinding FontSize}"
                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Surface" Property="Background" Value="{StaticResource Menu.DarkOlive}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="Surface" Property="Opacity" Value="0.76" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter TargetName="Surface" Property="Opacity" Value="0.42" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Menu.PrimaryButton" TargetType="Button">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Background" Value="{StaticResource Menu.Olive}" />
      <Setter Property="Foreground" Value="{StaticResource Menu.Cream}" />
      <Setter Property="BorderBrush" Value="{StaticResource Menu.DarkOlive}" />
      <Setter Property="BorderThickness" Value="0,0,0,3" />
      <Setter Property="Padding" Value="20,12" />
      <Setter Property="MinHeight" Value="58" />
      <Setter Property="FontFamily" Value="{DynamicResource GalapagOS.FontFamily.Primary}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#77372C15" BlurRadius="5" Direction="315" ShadowDepth="2" />
        </Setter.Value>
      </Setter>
      <Setter Property="Template" Value="{StaticResource Menu.PrimaryButtonTemplate}" />
    </Style>

    <ControlTemplate x:Key="Menu.SecondaryButtonTemplate" TargetType="Button">
      <Grid>
        <Border x:Name="FocusRing"
                Margin="-4"
                BorderBrush="{StaticResource Menu.Pollen}"
                BorderThickness="3"
                CornerRadius="10"
                Opacity="0" />
        <Border x:Name="Surface"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="7">
          <Grid>
            <Border x:Name="HoverEdge"
                    Width="4"
                    HorizontalAlignment="Left"
                    Background="{StaticResource Menu.Coral}"
                    CornerRadius="7,0,0,7"
                    Opacity="0"
                    IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                              TextElement.FontSize="{TemplateBinding FontSize}"
                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Surface" Property="Background" Value="#FFFFFFFF" />
          <Setter TargetName="HoverEdge" Property="Opacity" Value="1" />
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter TargetName="Surface" Property="Opacity" Value="0.42" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Menu.SecondaryButton" TargetType="Button">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Background" Value="{StaticResource Menu.Cream}" />
      <Setter Property="Foreground" Value="{StaticResource Menu.Ink}" />
      <Setter Property="BorderBrush" Value="{StaticResource Menu.DarkOlive}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="FontFamily" Value="{DynamicResource GalapagOS.FontFamily.Primary}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#55372C15" BlurRadius="3" Direction="315" ShadowDepth="1" />
        </Setter.Value>
      </Setter>
      <Setter Property="Template" Value="{StaticResource Menu.SecondaryButtonTemplate}" />
    </Style>

    <Style x:Key="Menu.ProfileButton" TargetType="Button" BasedOn="{StaticResource Menu.SecondaryButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <ControlTemplate x:Key="Menu.ProfileInputTemplate" TargetType="TextBox">
      <Grid>
        <Border x:Name="FocusRing"
                Margin="-4"
                BorderBrush="{StaticResource Menu.Pollen}"
                BorderThickness="3"
                CornerRadius="9"
                Opacity="0" />
        <Border x:Name="InputSurface"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="6">
          <ScrollViewer x:Name="PART_ContentHost"
                        Focusable="False"
                        Padding="{TemplateBinding Padding}"
                        Foreground="{TemplateBinding Foreground}" />
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter TargetName="InputSurface" Property="Opacity" Value="0.42" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Menu.ProfileInput" TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource Menu.Ink}" />
      <Setter Property="BorderBrush" Value="{StaticResource Menu.DarkOlive}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CaretBrush" Value="{StaticResource Menu.Ink}" />
      <Setter Property="SelectionBrush" Value="{StaticResource Menu.Lime}" />
      <Setter Property="SelectionOpacity" Value="0.8" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="FontFamily" Value="{DynamicResource GalapagOS.FontFamily.Primary}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Template" Value="{StaticResource Menu.ProfileInputTemplate}" />
    </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Background="#FF9DCDEB">
    <Image Source="{StaticResource GalapagOS.Image.Background.MainMenu}"
           Stretch="UniformToFill"
           RenderOptions.BitmapScalingMode="NearestNeighbor" />
    <Rectangle Fill="{StaticResource Menu.LeftScrim}" IsHitTestVisible="False" />

    <Viewbox Stretch="Uniform" StretchDirection="Both">
      <Grid x:Name="LaunchCanvas" Width="1280" Height="720">
      <Grid.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="MainMenuPanel"
                               Storyboard.TargetProperty="Opacity"
                               From="0" To="1" BeginTime="0:0:0.12" Duration="0:0:0.42"
                               DecelerationRatio="1" />
              <DoubleAnimation Storyboard.TargetName="MainMenuPanel"
                               Storyboard.TargetProperty="RenderTransform.X"
                               From="-18" To="0" BeginTime="0:0:0.12" Duration="0:0:0.5"
                               DecelerationRatio="1" />
              <DoubleAnimation Storyboard.TargetName="FooterStrip"
                               Storyboard.TargetProperty="Opacity"
                               From="0" To="1" BeginTime="0:0:0.28" Duration="0:0:0.4" />
              <DoubleAnimation Storyboard.TargetName="PollenOne"
                               Storyboard.TargetProperty="RenderTransform.Y"
                               From="0" To="-18" Duration="0:0:3.8"
                               AutoReverse="True" RepeatBehavior="Forever" />
              <DoubleAnimation Storyboard.TargetName="PollenOne"
                               Storyboard.TargetProperty="Opacity"
                               From="0.18" To="0.58" Duration="0:0:2.9"
                               AutoReverse="True" RepeatBehavior="Forever" />
              <DoubleAnimation Storyboard.TargetName="PollenTwo"
                               Storyboard.TargetProperty="RenderTransform.Y"
                               From="0" To="-13" BeginTime="0:0:0.7" Duration="0:0:3.2"
                               AutoReverse="True" RepeatBehavior="Forever" />
              <DoubleAnimation Storyboard.TargetName="PollenTwo"
                               Storyboard.TargetProperty="Opacity"
                               From="0.12" To="0.45" BeginTime="0:0:0.7" Duration="0:0:2.5"
                               AutoReverse="True" RepeatBehavior="Forever" />
              <DoubleAnimation Storyboard.TargetName="PollenThree"
                               Storyboard.TargetProperty="RenderTransform.Y"
                               From="0" To="-22" BeginTime="0:0:1.3" Duration="0:0:4.4"
                               AutoReverse="True" RepeatBehavior="Forever" />
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Grid.Triggers>

      <Canvas IsHitTestVisible="False">
        <Ellipse x:Name="PollenOne"
                 Canvas.Left="1036" Canvas.Top="318"
                 Width="6" Height="6"
                 Fill="{StaticResource Menu.Pollen}" Opacity="0.18">
          <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="PollenTwo"
                 Canvas.Left="1132" Canvas.Top="236"
                 Width="4" Height="4"
                 Fill="{StaticResource Menu.Cream}" Opacity="0.12">
          <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="PollenThree"
                 Canvas.Left="924" Canvas.Top="398"
                 Width="5" Height="5"
                 Fill="{StaticResource Menu.Pollen}" Opacity="0.28">
          <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
        </Ellipse>
      </Canvas>

      <Border Height="92"
              VerticalAlignment="Bottom"
              Background="#3822180D"
              IsHitTestVisible="False" />

      <Grid Margin="68,44,68,44">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Width="520"
                    HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <Border Background="{StaticResource Menu.Lime}"
                    BorderBrush="{StaticResource Menu.DarkOlive}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="9,4"
                    VerticalAlignment="Center">
              <TextBlock Text="FIELD SYSTEM 01"
                         FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                         FontSize="11"
                         Foreground="{StaticResource Menu.Ink}" />
            </Border>
            <TextBlock Text="  //  ECOLOGY ONLINE"
                       VerticalAlignment="Center"
                       FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                       FontSize="11"
                       Foreground="{StaticResource Menu.Cream}" />
          </StackPanel>

          <TextBlock Margin="0,10,0,0"
                     FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                     FontSize="62"
                     FontWeight="Bold"
                     Foreground="{StaticResource Menu.Cream}">
            <TextBlock.Effect>
              <DropShadowEffect Color="#CC372C15" BlurRadius="2" Direction="315" ShadowDepth="4" />
            </TextBlock.Effect>
            <Run Text="GALAPAG" /><Run Text="OS" Foreground="{StaticResource Menu.Pollen}" />
          </TextBlock>
          <TextBlock Text="Shape a species. Watch a world answer."
                     Margin="3,-5,0,0"
                     FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                     FontSize="20"
                     Foreground="{StaticResource Menu.Cream}" />
        </StackPanel>

        <Border x:Name="MainMenuPanel"
                Grid.Row="1"
                Visibility="{Binding MainMenuVisibility}"
                Width="416"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="0,0,0,8"
                Padding="24"
                Background="{StaticResource Menu.PanelBackground}"
                BorderBrush="{StaticResource Menu.DarkOlive}"
                BorderThickness="2"
                CornerRadius="12">
          <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
          <Border.Effect>
            <DropShadowEffect Color="#99372C15" BlurRadius="18" Direction="315" ShadowDepth="8" />
          </Border.Effect>
          <StackPanel>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="44"
                      Height="44"
                      Background="{StaticResource Menu.Lime}"
                      BorderBrush="{StaticResource Menu.DarkOlive}"
                      BorderThickness="1"
                      CornerRadius="8">
                <Image Source="{StaticResource GalapagOS.Image.Icon.Sprout}"
                       Width="28"
                       Height="28"
                       Stretch="Uniform" />
              </Border>
              <StackPanel Grid.Column="1" Margin="12,1,0,0">
                <TextBlock Text="EXPEDITION DESK"
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                           FontSize="11"
                           Foreground="{StaticResource Menu.DarkOlive}" />
                <TextBlock Text="Your living world awaits"
                           Margin="0,2,0,0"
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource Menu.Ink}" />
              </StackPanel>
            </Grid>

            <Border Background="#87FFFFFF"
                    BorderBrush="#406F7E3A"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="12,9"
                    Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="ACTIVE RESEARCHER"
                             FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                             FontSize="9"
                             Foreground="{StaticResource Menu.DarkOlive}" />
                  <TextBlock Text="{Binding CurrentProfileName}"
                             Margin="0,2,0,0"
                             FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                             FontSize="14"
                             FontWeight="Bold"
                             Foreground="{StaticResource Menu.Ink}" />
                </StackPanel>
                <Ellipse Grid.Column="1"
                         Width="10"
                         Height="10"
                         Fill="{StaticResource Menu.Coral}"
                         Stroke="{StaticResource Menu.Ink}"
                         StrokeThickness="1"
                         VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Button x:Name="ContinueButton"
                    Command="{Binding ContinueCommand}"
                    IsEnabled="{Binding ContinueEnabled}"
                    Style="{StaticResource Menu.PrimaryButton}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="CONTINUE"
                             FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                             FontSize="18"
                             FontWeight="Bold" />
                  <TextBlock Text="ENTER THE GALAPAGOS LAB"
                             Margin="0,2,0,0"
                             FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                             FontSize="9" />
                </StackPanel>
                <Path Grid.Column="1"
                      Data="M2,7 H16 M11,2 L16,7 L11,12"
                      Width="20"
                      Height="16"
                      Stretch="Uniform"
                      Stroke="{StaticResource Menu.Cream}"
                      StrokeThickness="2"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      VerticalAlignment="Center" />
              </Grid>
            </Button>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="112" />
              </Grid.ColumnDefinitions>
              <Button x:Name="ProfileSelectionButton"
                      Content="PROFILE SELECTION"
                      Command="{Binding OpenProfileSelectionCommand}"
                      Style="{StaticResource Menu.SecondaryButton}" />
              <Button Grid.Column="2"
                      Content="QUIT"
                      Command="{Binding RequestQuitCommand}"
                      Style="{StaticResource Menu.SecondaryButton}" />
            </Grid>
          </StackPanel>
        </Border>

        <Grid x:Name="FooterStrip" Grid.Row="2">
          <TextBlock Text="A CELLULAR AUTOMATA ROGUELIKE"
                     FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                     FontSize="11"
                     Foreground="{StaticResource Menu.Cream}" />
          <TextBlock Text="FOREST EDGE  •  DAWN CYCLE"
                     HorizontalAlignment="Right"
                     FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                     FontSize="11"
                     Foreground="{StaticResource Menu.Cream}" />
        </Grid>
      </Grid>

      <Grid Visibility="{Binding ProfileSelectionVisibility}" Panel.ZIndex="20">
        <Border Background="#B8372C15" />
        <Border Width="640"
                MaxHeight="620"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource Menu.PanelBackground}"
                BorderBrush="{StaticResource Menu.DarkOlive}"
                BorderThickness="2"
                CornerRadius="12">
          <Border.Effect>
            <DropShadowEffect Color="#CC372C15" BlurRadius="24" Direction="315" ShadowDepth="10" />
          </Border.Effect>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="76" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Menu.Lime}" CornerRadius="10,10,0,0">
              <Grid>
                <Rectangle Height="30"
                           VerticalAlignment="Top"
                           Margin="0,6,0,0"
                           Fill="{DynamicResource GalapagOS.Brush.TopStripes}" />
                <StackPanel Orientation="Horizontal" Margin="24,0" VerticalAlignment="Center">
                  <Image Source="{StaticResource GalapagOS.Image.Icon.Clipboard}"
                         Width="36"
                         Height="36"
                         Stretch="Uniform" />
                  <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="RESEARCHER PROFILES"
                               FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource Menu.Ink}" />
                    <TextBlock Text="WHO IS ENTERING THE FIELD?"
                               FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                               FontSize="9"
                               Foreground="{StaticResource Menu.DarkOlive}" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="28,24,28,26">
              <TextBlock Text="NEW RESEARCHER"
                         FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                         FontSize="11"
                         Foreground="{StaticResource Menu.DarkOlive}" />
              <TextBlock Text="Name your first field profile. Your expeditions and discoveries will be kept here."
                         Margin="0,5,0,12"
                         TextWrapping="Wrap"
                         FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                         FontSize="14"
                         Foreground="{StaticResource Menu.Ink}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding ProfileNameInput}"
                         Height="46"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource Menu.ProfileInput}" />
                <Button Grid.Column="2"
                        Content="CREATE PROFILE"
                        Command="{Binding CreateInitialProfileCommand}"
                        IsEnabled="{Binding CreateInitialProfileEnabled}"
                        Style="{StaticResource Menu.PrimaryButton}"
                        MinHeight="46"
                        Padding="14,8"
                        FontSize="14" />
              </Grid>

              <Grid Margin="0,22,0,10">
                <TextBlock Text="SAVED PROFILES"
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                           FontSize="11"
                           Foreground="{StaticResource Menu.DarkOlive}" />
                <Border Height="1"
                        Margin="118,0,0,0"
                        Background="#506F7E3A"
                        VerticalAlignment="Center" />
              </Grid>

              <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Profiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding ProfileName}"
                              Command="{Binding SelectCommand}"
                              Style="{StaticResource Menu.ProfileButton}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <Button Content="BACK TO MAIN MENU"
                      Command="{Binding CloseProfileSelectionCommand}"
                      Width="220"
                      Margin="0,18,0,0"
                      HorizontalAlignment="Left"
                      Style="{StaticResource Menu.SecondaryButton}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Grid Visibility="{Binding QuitConfirmationVisibility}" Panel.ZIndex="30">
        <Border Background="#C3372C15" />
        <Border Width="500"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource Menu.PanelBackground}"
                BorderBrush="{StaticResource Menu.DarkOlive}"
                BorderThickness="2"
                CornerRadius="12">
          <Border.Effect>
            <DropShadowEffect Color="#CC372C15" BlurRadius="24" Direction="315" ShadowDepth="10" />
          </Border.Effect>
          <StackPanel>
            <Border Width="54"
                    Height="54"
                    Background="{StaticResource Menu.Coral}"
                    BorderBrush="{StaticResource Menu.Ink}"
                    BorderThickness="2"
                    CornerRadius="27"
                    HorizontalAlignment="Center">
              <TextBlock Text="×"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                         FontSize="34"
                         FontWeight="Bold"
                         Foreground="{StaticResource Menu.Ink}" />
            </Border>
            <TextBlock Text="LEAVE THE FIELD?"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center"
                       FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{StaticResource Menu.Ink}" />
            <TextBlock Text="Your current profile is safe. GalapagOS will close and the meadow will keep growing without you."
                       Margin="20,9,20,22"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                       FontSize="14"
                       Foreground="{StaticResource Menu.Ink}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Content="STAY"
                      Command="{Binding CancelQuitCommand}"
                      Style="{StaticResource Menu.SecondaryButton}" />
              <Button Grid.Column="2"
                      Content="QUIT TO DESKTOP"
                      Command="{Binding ConfirmQuitCommand}"
                      Style="{StaticResource Menu.PrimaryButton}"
                      FontSize="14"
                      MinHeight="46"
                      Padding="14,8" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <Grid x:Name="BootOverlay"
            Panel.ZIndex="40"
            Background="#F1091512"
            Opacity="0"
            IsHitTestVisible="False">
        <Grid.Triggers>
          <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="BootScreen"
                                 Storyboard.TargetProperty="RenderTransform.ScaleY"
                                 From="0.04" To="1" BeginTime="0:0:0.08"
                                 Duration="0:0:0.42" DecelerationRatio="1" />
                <DoubleAnimation Storyboard.TargetName="BootScanline"
                                 Storyboard.TargetProperty="Width"
                                 From="0" To="520" BeginTime="0:0:0.12"
                                 Duration="0:0:0.26" DecelerationRatio="1" />
                <DoubleAnimation Storyboard.TargetName="BootOverlay"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" BeginTime="0:0:0.56"
                                 Duration="0:0:0.46" />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Grid.Triggers>
        <Border x:Name="BootScreen"
                Width="520"
                Height="300"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F414201A"
                BorderBrush="#AA84A340"
                BorderThickness="2"
                CornerRadius="10"
                RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><ScaleTransform ScaleY="0.04" /></Border.RenderTransform>
          <Grid>
            <Rectangle Fill="#2A9DCDEB" IsHitTestVisible="False" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="GALAPAGOS // FIELD SYSTEM"
                         HorizontalAlignment="Center"
                         FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                         FontSize="15"
                         Foreground="{StaticResource Menu.Lime}" />
              <TextBlock Text="SIGNAL FOUND"
                         Margin="0,12,0,0"
                         HorizontalAlignment="Center"
                         FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                         FontSize="24"
                         FontWeight="Bold"
                         Foreground="{StaticResource Menu.Cream}" />
              <TextBlock Text="TUNING THE LIVING WORLD"
                         Margin="0,6,0,0"
                         HorizontalAlignment="Center"
                         FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                         FontSize="10"
                         Foreground="{StaticResource Menu.Pollen}" />
            </StackPanel>
            <Rectangle x:Name="BootScanline"
                       Width="0"
                       Height="3"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Fill="{StaticResource Menu.Pollen}" />
            <Border Margin="22"
                    BorderBrush="#226F7E3A"
                    BorderThickness="1"
                    CornerRadius="5"
                    IsHitTestVisible="False" />
          </Grid>
        </Border>
      </Grid>

      <Grid x:Name="DesktopTransitionOverlay"
            Visibility="{Binding DesktopTransitionVisibility}"
            Panel.ZIndex="50"
            Opacity="0" Background="#F1608A80" IsHitTestVisible="False">
        <Grid.Triggers>
          <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="DesktopTransitionOverlay"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.16" />
                <DoubleAnimation Storyboard.TargetName="TransitionScanline"
                                 Storyboard.TargetProperty="Width"
                                 From="0" To="520" BeginTime="0:0:0.1"
                                 Duration="0:0:0.36" DecelerationRatio="1" />
                <DoubleAnimation Storyboard.TargetName="TransitionCopy"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" BeginTime="0:0:0.24"
                                 Duration="0:0:0.3" />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Grid.Triggers>
        <Border Width="700"
                Height="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#E616241C"
                BorderBrush="#6684A340"
                BorderThickness="2"
                CornerRadius="10">
          <Grid>
            <Border Margin="20"
                    BorderBrush="#226F7E3A"
                    BorderThickness="1"
                    CornerRadius="5" />
            <StackPanel x:Name="TransitionCopy"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0">
              <TextBlock Text="GALAPAGOS DESKTOP"
                         HorizontalAlignment="Center"
                         FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                         FontSize="28"
                         FontWeight="Bold"
                         Foreground="{StaticResource Menu.Cream}" />
              <TextBlock Text="OPENING A WINDOW INTO THE WILD"
                         Margin="0,10,0,0"
                         HorizontalAlignment="Center"
                         FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                         FontSize="11"
                         Foreground="{StaticResource Menu.Lime}" />
              <Border x:Name="TransitionScanline"
                      Width="0"
                      Height="3"
                      Margin="0,24,0,0"
                      HorizontalAlignment="Center"
                      Background="{StaticResource Menu.Pollen}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
      </Grid>
    </Viewbox>
  </Grid>
</UserControl>
