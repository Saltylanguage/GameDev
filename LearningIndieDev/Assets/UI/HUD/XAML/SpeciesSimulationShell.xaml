<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:game="clr-namespace:SaltyGame"
             xmlns:noesis="clr-namespace:NoesisApp;assembly=Noesis.NoesisGUI">
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
    <Grid Width="1280"
          Height="720"
          Margin="24">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Padding="18,12"
                Background="#D9161F2B"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="CELLULAR SPECIES SIMULATION"
                           Foreground="#FFF1C27D"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StateTitle}"
                           Foreground="White"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
                <TextBlock Text="{Binding ScenarioText}"
                           Foreground="#FFD9E7F0"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
                <TextBlock Text="{Binding PlayerSpeciesText}"
                           Foreground="#FFFFD27D"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>
                <TextBlock Text="{Binding RosterText}"
                           Foreground="#FFD9E7F0"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"/>
                <TextBlock Text="{Binding CurrencyText}"
                           Foreground="#FFD9E7F0"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Grid Visibility="{Binding BoardVisibility}"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="1150"
              Height="600"
              Margin="0,72,0,0"
              ClipToBounds="True">
            <game:SpeciesSimulationBoard x:Name="SimulationBoard"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Width="1150"
                                         Height="600">
                <b:Interaction.Behaviors>
                    <noesis:TranslateZoomRotateBehavior SupportedGestures="Translate,Scale"
                                                         MinimumScale="0.75"
                                                         MaximumScale="4"
                                                         WheelSensitivity="0.15"
                                                         ConstrainToParentBounds="True"/>
                </b:Interaction.Behaviors>
            </game:SpeciesSimulationBoard>
        </Grid>

        <Border Visibility="{Binding SettingsVisibility}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,88,0,0"
                Width="760"
                Height="608"
                Padding="18"
                Background="#F51B2A38"
                CornerRadius="10">
            <ScrollViewer Height="572"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Ready for the next evolutionary run"
                           Foreground="White"
                           FontSize="24"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock Text="Tune global settings and species rules before starting the next run."
                           Foreground="#FFD9E7F0"
                           FontSize="14"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,12"/>
                <CheckBox Content="DEVELOPER MODE — SHOW SIMULATION DASHBOARD"
                          IsChecked="{Binding DeveloperMode, Mode=TwoWay}"
                          Foreground="#FFF1C27D"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"/>
                <StackPanel Visibility="{Binding PlayerSettingsVisibility}">
                    <TextBlock Text="Choose a scenario, then start your expedition. Advanced simulation tuning is available in Developer Mode."
                               Foreground="#FFD9E7F0"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="Scenario" Foreground="White" Width="250" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding ScenarioOptions}"
                                  SelectedIndex="{Binding SelectedScenarioIndex, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditSettings}"
                                  Width="300"
                                  Height="34"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="Player species" Foreground="White" Width="250" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding PlayerSpeciesOptions}"
                                  SelectedIndex="{Binding SelectedPlayerSpeciesIndex, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditSettings}"
                                  Width="300"
                                  Height="34"/>
                    </StackPanel>
                    <TextBlock Text="{Binding RosterText}"
                               Foreground="#FFD9E7F0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,8,0,4"/>
                </StackPanel>
                <ScrollViewer Height="270"
                              Visibility="{Binding DeveloperSettingsVisibility}"
                              IsEnabled="{Binding CanEditSettings}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Scenario" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding ScenarioOptions}"
                                      SelectedIndex="{Binding SelectedScenarioIndex, Mode=TwoWay}"
                                      IsEnabled="{Binding CanEditSettings}"
                                      Width="300"
                                      Height="34"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Grid width" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding GridWidthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Grid height" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding GridHeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Base seed" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding BaseSeedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Maximum population" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding MaximumPopulationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Minimum population" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding MinimumPopulationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Run duration (seconds)" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding RunDurationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Step interval (seconds)" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding StepIntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Plant start chance" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding PlantProbabilityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Herbivore start chance" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding HerbivoreProbabilityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Carnivore start chance" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding CarnivoreProbabilityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <CheckBox Content="Randomize seed on start"
                                  IsChecked="{Binding RandomizeSeedOnStart, Mode=TwoWay}"
                                  Foreground="White"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Text="{Binding SelectedRuleSpeciesTitle}"
                           Visibility="{Binding DeveloperSettingsVisibility}"
                           Foreground="#FFF1C27D"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,4"/>
                <ComboBox ItemsSource="{Binding SpeciesTabs}"
                          Visibility="{Binding DeveloperSettingsVisibility}"
                          SelectedIndex="{Binding SelectedRuleSpeciesIndex, Mode=TwoWay}"
                          IsEnabled="{Binding CanEditSettings}"
                          Height="34"
                          Margin="0,0,0,6"/>
                <ScrollViewer Height="390"
                              Visibility="{Binding DeveloperSettingsVisibility}"
                              IsEnabled="{Binding CanEditSettings}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <CheckBox Content="Movement enabled" IsChecked="{Binding MovementEnabled, Mode=TwoWay}" Foreground="White" Margin="0,3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Movement speed" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding MovementSpeedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Movement pattern" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding MovementPattern, Mode=TwoWay}" Width="140">
                                <ComboBoxItem Content="Cardinal"/>
                                <ComboBoxItem Content="Moore"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox Content="Attack enabled" IsChecked="{Binding AttackEnabled, Mode=TwoWay}" Foreground="White" Margin="0,3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Attack amount" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding AttackAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Attack pattern" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding AttackPattern, Mode=TwoWay}" Width="140">
                                <ComboBoxItem Content="Cardinal"/>
                                <ComboBoxItem Content="Moore"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Block amount" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding BlockAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Block pattern" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding BlockPattern, Mode=TwoWay}" Width="140">
                                <ComboBoxItem Content="Cardinal"/>
                                <ComboBoxItem Content="Moore"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Diet target" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding DietTarget, Mode=TwoWay}" Width="140">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="Plant"/>
                                <ComboBoxItem Content="Herbivore"/>
                                <ComboBoxItem Content="Carnivore"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Diet pattern" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding DietPattern, Mode=TwoWay}" Width="140">
                                <ComboBoxItem Content="Cardinal"/>
                                <ComboBoxItem Content="Moore"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Reproduction pattern" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding ReproductionPattern, Mode=TwoWay}" Width="140">
                                <ComboBoxItem Content="Cardinal"/>
                                <ComboBoxItem Content="Moore"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox Content="Reproduction enabled" IsChecked="{Binding ReproductionEnabled, Mode=TwoWay}" Foreground="White" Margin="0,3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Reproduction chance" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding ReproductionChanceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Nearby mate requirement" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding ReproductionNeighborCountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Energy transferred to offspring" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding ReproductionFoodRequiredText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Maximum group size" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding MaxReproductionGroupSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Starting energy" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding StartingEnergyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Maximum energy reserve" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding MaximumEnergyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Minimum litter size" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding LitterMinimumText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Maximum litter size" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding LitterMaximumText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Forage at or below energy" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding ForageBelowEnergyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Energy value" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding EnergyValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Metabolism (- adds)" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding MetabolismText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Vision range" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding VisionRangeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Intelligence" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding IntelligenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <CheckBox Content="Wilt enabled" IsChecked="{Binding WiltEnabled, Mode=TwoWay}" Foreground="White" Margin="0,3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Wilt chance" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding WiltChanceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Crowding cost" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding CrowdingEnergyPenaltyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Starting food reserve" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding StartingFoodReserveText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <CheckBox Content="Seed drops enabled" IsChecked="{Binding SeedDropEnabled, Mode=TwoWay}" Foreground="White" Margin="0,3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Seed drop chance" Foreground="White" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SeedDropChanceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Button Content="APPLY SPECIES RULES"
                        Visibility="{Binding DeveloperSettingsVisibility}"
                        Command="{Binding ApplySpeciesRulesCommand}"
                        IsEnabled="{Binding CanEditSettings}"
                        Height="40"
                        Margin="0,8,0,0"/>
                <TextBlock Text="{Binding SettingsMessage}"
                           Foreground="#FFFFD27D"
                           FontSize="13"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="APPLY SETTINGS"
                            Visibility="{Binding DeveloperSettingsVisibility}"
                            Command="{Binding ApplySettingsCommand}"
                            IsEnabled="{Binding CanEditSettings}"
                            Width="180"
                            Height="42"
                            Margin="0,0,8,0"/>
                    <Button Content="SAVE DEFAULT"
                            Visibility="{Binding DeveloperSettingsVisibility}"
                            Command="{Binding SaveSettingsCommand}"
                            IsEnabled="{Binding CanEditSettings}"
                            Width="150"
                            Height="42"
                            Margin="0,0,8,0"/>
                    <Button Content="START"
                            Command="{Binding StartCommand}"
                            IsEnabled="{Binding CanStart}"
                            Width="100"
                            Height="42"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Visibility="{Binding RunningVisibility}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Width="340"
                Padding="18"
                Background="#F51B2A38"
                CornerRadius="10">
            <StackPanel>
                <TextBlock Text="{Binding RunStatusText}"
                           Foreground="#FF8FE3A8"
                           FontSize="18"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding RunDetailsText}"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,6,0,14"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="PAUSE"
                            Command="{Binding PauseCommand}"
                            IsEnabled="{Binding CanPause}"
                            Width="92"
                            Height="42"
                            Margin="0,0,8,0"/>
                    <Button Content="RESTART"
                            Command="{Binding RestartCommand}"
                            IsEnabled="{Binding CanRestart}"
                            Width="102"
                            Height="42"
                            Margin="0,0,8,0"/>
                    <Button Content="STOP"
                            Command="{Binding StopCommand}"
                            IsEnabled="{Binding CanStop}"
                            Width="74"
                            Height="42"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Visibility="{Binding PausedVisibility}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Width="340"
                Padding="18"
                Background="#F5513A26"
                CornerRadius="10">
            <StackPanel>
                <TextBlock Text="SIMULATION PAUSED"
                           Foreground="#FFFFD27D"
                           FontSize="18"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding RunDetailsText}"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,6,0,14"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="RESUME"
                            Command="{Binding ResumeCommand}"
                            IsEnabled="{Binding CanResume}"
                            Width="105"
                            Height="42"
                            Margin="0,0,8,0"/>
                    <Button Content="RESTART"
                            Command="{Binding RestartCommand}"
                            IsEnabled="{Binding CanRestart}"
                            Width="102"
                            Height="42"
                            Margin="0,0,8,0"/>
                    <Button Content="STOP"
                            Command="{Binding StopCommand}"
                            IsEnabled="{Binding CanStop}"
                            Width="74"
                            Height="42"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Visibility="{Binding RewardsVisibility}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="520"
                Padding="28"
                Background="#F51B2A38"
                CornerRadius="10">
            <StackPanel>
                <TextBlock Text="Run complete"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Choose an upgrade for your player species."
                           Foreground="#FFD9E7F0"
                           FontSize="16"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="FASTER"
                            Command="{Binding PurchaseMovementUpgradeCommand}"
                            IsEnabled="{Binding CanPurchaseMovementUpgrade}"
                            Width="130"
                            Height="50"
                            Margin="0,0,8,0"/>
                    <Button Content="ATTACK"
                            Command="{Binding PurchaseAttackUpgradeCommand}"
                            IsEnabled="{Binding CanPurchaseAttackUpgrade}"
                            Width="130"
                            Height="50"
                            Margin="0,0,8,0"/>
                    <Button Content="BLOCK"
                            Command="{Binding PurchaseBlockUpgradeCommand}"
                            IsEnabled="{Binding CanPurchaseBlockUpgrade}"
                            Width="130"
                            Height="50"/>
                </StackPanel>
                <Button Content="CONTINUE WITHOUT UPGRADE"
                        Command="{Binding ContinueWithoutUpgradeCommand}"
                        Height="44"
                        Margin="0,14,0,0"/>
            </StackPanel>
        </Border>

        <Border Visibility="{Binding ResultsVisibility}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="520"
                Padding="28"
                Background="#F51B2A38"
                CornerRadius="10">
            <StackPanel>
                <TextBlock Text="Species update"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="The player update is applied. Continue into the next run when ready."
                           Foreground="#FFD9E7F0"
                           FontSize="16"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="PLAY NEXT SIMULATION"
                            Command="{Binding PlayNextSimulationCommand}"
                            IsEnabled="{Binding CanPlayNextSimulation}"
                            Width="250"
                            Height="50"
                            Margin="0,0,8,0"/>
                    <Button Content="RESET"
                            Command="{Binding ResetCommand}"
                            Width="100"
                            Height="50"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </Viewbox>
</UserControl>
