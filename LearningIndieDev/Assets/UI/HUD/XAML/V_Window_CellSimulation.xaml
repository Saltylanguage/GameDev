<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:game="clr-namespace:SaltyGame"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="RD_SimulationShellResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform" StretchDirection="Both">
    <Grid Width="1280"
          Height="720"
          Margin="24">
        <HeaderedContentControl x:Name="SimulationWindow"
                                Header="ECOLOGY SIMULATION"
                                game:GalapagOSWindow.IconSource="{StaticResource GalapagOS.Image.Icon.Sprout}"
                                game:GalapagOSWindow.CloseCommand="{Binding CloseWindowCommand}"
                                game:GalapagOSWindow.CloseEnabled="{Binding CanCloseWindow}"
                                Background="{DynamicResource Chrono_LightCream}"
                                Style="{StaticResource GalapagOS_HeaderedWindowStyle}">
            <Grid>
                <Image Source="{StaticResource GalapagOS.Image.Simulation.PaperTexture}"
                       Stretch="UniformToFill"
                       Opacity="0.34"
                       IsHitTestVisible="False" />
                <Rectangle Fill="{StaticResource GalapagOS.Brush.PaperRules}"
                           Opacity="0.10"
                           IsHitTestVisible="False" />
                <Border HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Padding="12,7"
                        Background="{DynamicResource Chrono_Lime}"
                        BorderBrush="{DynamicResource Chrono_Olive}"
                        BorderThickness="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.ColumnSpan="4"
                               Source="{StaticResource GalapagOS.Image.Simulation.BotanicalSketch}"
                               Width="340"
                               Height="54"
                               Margin="0,-4,18,-4"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Stretch="Uniform"
                               Opacity="0.20"
                               IsHitTestVisible="False" />
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource GalapagOS.Image.Icon.FlowerPurple}"
                                   Width="24"
                                   Height="24"
                                   Stretch="Uniform"
                                   Margin="0,0,8,0" />
                            <StackPanel>
                                <TextBlock Text="ECOLOGY FIELD VIEW"
                                           Foreground="{DynamicResource Chrono_TreeBark}"
                                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                           FontSize="11"
                                           FontWeight="Bold" />
                                <TextBlock Text="{Binding ScenarioText}"
                                           Foreground="{DynamicResource Chrono_TreeBark}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Image Source="{StaticResource GalapagOS.Image.Species.Rabbit.32}"
                                   Width="26"
                                   Height="26"
                                   Stretch="Uniform"
                                   Margin="0,0,8,0" />
                            <StackPanel>
                                <TextBlock Text="PLAYER SPECIES"
                                       Foreground="{DynamicResource Chrono_TreeBark}"
                                       FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                       FontSize="11"
                                       FontWeight="Bold" />
                                <TextBlock Text="{Binding PlayerSpeciesText}"
                                           Foreground="{DynamicResource Chrono_Olive}"
                                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Image Source="{StaticResource GalapagOS.Image.Icon.Sprout}"
                                   Width="22"
                                   Height="22"
                                   Stretch="Uniform"
                                   Margin="0,0,7,0" />
                            <TextBlock Text="{Binding PhaseText}"
                                       Foreground="{DynamicResource Chrono_TreeBark}"
                                       FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="3"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="RESEARCH DATA"
                                       Foreground="{DynamicResource Chrono_TreeBark}"
                                       FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding CurrencyText}"
                                       Foreground="{DynamicResource Chrono_TreeBark}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Visibility="{Binding BoardVisibility}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="18,68,302,76"
                      Padding="10"
                      Background="{DynamicResource Chrono_LightCream}"
                      BorderBrush="{DynamicResource Chrono_Olive}"
                      BorderThickness="3"
                      CornerRadius="8"
                      ClipToBounds="True">
                    <Grid>
                        <Image Source="{StaticResource GalapagOS.Image.Simulation.PaperTexture}"
                               Stretch="UniformToFill"
                               Opacity="0.30"
                               IsHitTestVisible="False" />
                        <Rectangle Fill="{StaticResource GalapagOS.Brush.PaperRules}"
                                   Opacity="0.10"
                                   IsHitTestVisible="False" />
                        <game:SpeciesSimulationBoard x:Name="SimulationBoard"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch" />
                        <Border Margin="-6"
                                BorderBrush="{DynamicResource Chrono_VanillaCream}"
                                BorderThickness="2"
                                CornerRadius="6"
                                IsHitTestVisible="False" />
                        <Border Margin="-3"
                                BorderBrush="{DynamicResource Chrono_Sand}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Opacity="0.42"
                                IsHitTestVisible="False" />
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="10"
                                Padding="8,5"
                                Background="{DynamicResource Chrono_LightCream}"
                                BorderBrush="{DynamicResource Chrono_Sand}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Opacity="0.92">
                            <TextBlock Text="FIELD OBSERVATION BOARD"
                                       FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Chrono_TreeBark}" />
                        </Border>
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Padding="8,5"
                                Background="{DynamicResource Chrono_LightCream}"
                                BorderBrush="{DynamicResource Chrono_Sand}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Opacity="0.92">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Chrono_Olive}" Margin="0,0,5,0" />
                                <TextBlock Text="PLAYER SPECIES"
                                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Chrono_TreeBark}" />
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Chrono_GoldenPollen}" Margin="12,0,5,0" />
                                <TextBlock Text="RESOURCE"
                                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Chrono_TreeBark}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Visibility="{Binding BoardVisibility}"
                        HorizontalAlignment="Right"
                        Width="264"
                        Margin="0,68,18,0"
                        Padding="22,12,12,10"
                        Background="{DynamicResource Chrono_LightCream}"
                        BorderBrush="{DynamicResource Chrono_Sand}"
                        BorderThickness="2"
                        CornerRadius="8"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <Image Source="{StaticResource GalapagOS.Image.Simulation.PaperTexture}"
                               Stretch="UniformToFill"
                               Opacity="0.40"
                               IsHitTestVisible="False" />
                        <Rectangle Fill="{StaticResource GalapagOS.Brush.PaperRules}"
                                   Opacity="0.10"
                                   IsHitTestVisible="False" />
                        <Image Source="{StaticResource GalapagOS.Image.Simulation.BotanicalSketch}"
                               Width="116"
                               Height="42"
                               Margin="0,-5,-4,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Stretch="Uniform"
                               Opacity="0.48"
                               IsHitTestVisible="False" />
                        <Border Margin="-18,-8,-8,-6"
                                BorderBrush="{DynamicResource Chrono_VanillaCream}"
                                BorderThickness="2"
                                CornerRadius="6"
                                IsHitTestVisible="False" />
                        <Border Width="13"
                                Margin="-17,3,0,3"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Chrono_Sand}"
                                CornerRadius="5"
                                Opacity="0.18"
                                IsHitTestVisible="False" />
                        <Border Width="4"
                                Margin="-5,3,0,3"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Chrono_TreeBark}"
                                Opacity="0.42"
                                IsHitTestVisible="False" />
                        <StackPanel Margin="-22,5,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    IsHitTestVisible="False">
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                            <Border Style="{StaticResource GalapagOS.LedgerRing}" />
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{StaticResource GalapagOS.Image.Icon.Sprout}"
                                       Width="22"
                                       Height="22"
                                       Stretch="Uniform"
                                       Margin="0,0,7,0" />
                                <TextBlock Text="FIELD LEDGER"
                                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Chrono_Olive}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding RunStatusText}"
                                       Margin="0,7,0,0"
                                       Foreground="{DynamicResource Chrono_TreeBark}"
                                       FontSize="15"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding RunDetailsText}"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource Chrono_TreeBark}"
                                       FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                       FontSize="9"
                                       TextWrapping="Wrap" />
                            <Rectangle Height="1"
                                       Margin="0,8,0,7"
                                       Fill="Transparent"
                                       Stroke="{DynamicResource Chrono_Sand}"
                                       StrokeDashArray="7,4"
                                       StrokeThickness="2" />
                            <TextBlock Text="{Binding PhaseText}"
                                       FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Chrono_TreeBark}" />
                            <ItemsControl ItemsSource="{Binding PhaseTimelineItems}"
                                          Style="{StaticResource GalapagOS.Timeline}"
                                          ItemTemplate="{StaticResource GalapagOS_TimelineCompactItemTemplate}"
                                          Margin="0,5,0,4" />
                            <Rectangle Height="1"
                                       Margin="0,3,0,7"
                                       Fill="Transparent"
                                       Stroke="{DynamicResource Chrono_Sand}"
                                       StrokeDashArray="7,4"
                                       StrokeThickness="2" />
                            <TextBlock Text="POPULATION"
                                       FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Chrono_TreeBark}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="29" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{StaticResource GalapagOS.Image.Species.Rabbit.32}"
                                       Width="24"
                                       Height="24"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left" />
                                <ProgressBar Grid.Column="1"
                                             Value="{Binding HerbivorePopulation, Mode=OneWay}"
                                             Maximum="{Binding HerbivorePopulationMaximum, Mode=OneWay}"
                                             Style="{StaticResource GalapagOS.ProgressBar.Segmented}"
                                             MinWidth="90"
                                             Height="22"
                                             Margin="0,0,5,0"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding HerbivorePopulationText}"
                                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                           FontSize="9"
                                           Foreground="{DynamicResource Chrono_TreeBark}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="29" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{StaticResource GalapagOS.Image.Species.Fox.32}"
                                       Width="24"
                                       Height="24"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Left" />
                                <ProgressBar Grid.Column="1"
                                             Value="{Binding CarnivorePopulation, Mode=OneWay}"
                                             Maximum="{Binding CarnivorePopulationMaximum, Mode=OneWay}"
                                             Foreground="{DynamicResource Chrono_LightCoral}"
                                             Style="{StaticResource GalapagOS.ProgressBar.Segmented}"
                                             MinWidth="90"
                                             Height="22"
                                             Margin="0,0,5,0"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding CarnivorePopulationText}"
                                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                           FontSize="9"
                                           Foreground="{DynamicResource Chrono_TreeBark}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Rectangle Height="1"
                                       Margin="0,8,0,7"
                                       Fill="Transparent"
                                       Stroke="{DynamicResource Chrono_Sand}"
                                       StrokeDashArray="7,4"
                                       StrokeThickness="2" />
                            <TextBlock Text="RESEARCH DATA"
                                       FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Chrono_TreeBark}" />
                            <Border Height="104"
                                    Margin="0,5,0,0"
                                    Background="{DynamicResource Chrono_VanillaCream}"
                                    BorderBrush="{DynamicResource Chrono_Sand}"
                                    BorderThickness="2"
                                    CornerRadius="5"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image Source="{StaticResource GalapagOS.Image.Simulation.PaperTexture}"
                                           Stretch="UniformToFill"
                                           Opacity="0.34"
                                           IsHitTestVisible="False" />
                                    <Image Source="{StaticResource GalapagOS.Image.Simulation.SpecimenJars}"
                                           Margin="3,3,3,1"
                                           Stretch="Uniform"
                                           IsHitTestVisible="False" />
                                    <Border HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="4"
                                            Padding="4,2"
                                            Background="{DynamicResource Chrono_LightCream}"
                                            BorderBrush="{DynamicResource Chrono_Sand}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <TextBlock Text="COLLECTION 03"
                                                   FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                                   FontSize="7"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Chrono_TreeBark}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Grid Margin="1,3,1,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="PLANTS 6/8"
                                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                           FontSize="7"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Chrono_TreeBark}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="FLOWERS 4/8"
                                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                           FontSize="7"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Chrono_TreeBark}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="DATA 2/4"
                                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                           FontSize="7"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Chrono_TreeBark}"
                                           HorizontalAlignment="Center" />
                            </Grid>
                            <Rectangle Height="1"
                                       Margin="0,8,0,7"
                                       Fill="Transparent"
                                       Stroke="{DynamicResource Chrono_Sand}"
                                       StrokeDashArray="7,4"
                                       StrokeThickness="2" />
                            <TextBlock Text="ECOLOGY LEGEND"
                                       FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Chrono_TreeBark}" />
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Chrono_Olive}" Margin="0,0,5,0" />
                                    <TextBlock Text="GRASS" FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}" FontSize="8" Foreground="{DynamicResource Chrono_TreeBark}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Chrono_AzureSky}" Margin="0,0,5,0" />
                                    <TextBlock Text="WATER" FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}" FontSize="8" Foreground="{DynamicResource Chrono_TreeBark}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Chrono_GoldenPollen}" Margin="0,0,5,0" />
                                    <TextBlock Text="FLOWERS" FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}" FontSize="8" Foreground="{DynamicResource Chrono_TreeBark}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{DynamicResource Chrono_Sand}" Margin="0,0,5,0" />
                                    <TextBlock Text="ROCK" FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}" FontSize="8" Foreground="{DynamicResource Chrono_TreeBark}" />
                                </StackPanel>
                            </Grid>
                            <Button Style="{StaticResource GalapagOS.Button.FieldNotes}"
                                    Width="168"
                                    Height="38"
                                    Padding="7,4"
                                    Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image Source="{StaticResource GalapagOS.Image.Icon.Clipboard}"
                                           Width="22"
                                           Height="22"
                                           Stretch="Uniform"
                                           Margin="0,0,7,0" />
                                    <TextBlock Text="FIELD NOTES"
                                               FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Chrono_TreeBark}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Visibility="{Binding BoardVisibility}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Width="304"
                        Height="64"
                        Margin="18,0,0,0"
                        Padding="10,6"
                        Background="{DynamicResource Chrono_LightCream}"
                        BorderBrush="{DynamicResource Chrono_Sand}"
                        BorderThickness="2"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.ColumnSpan="2"
                               Source="{StaticResource GalapagOS.Image.Simulation.PaperTexture}"
                               Stretch="UniformToFill"
                               Opacity="0.34"
                               IsHitTestVisible="False" />
                        <Rectangle Grid.ColumnSpan="2"
                                   Fill="{StaticResource GalapagOS.Brush.PaperRules}"
                                   Opacity="0.10"
                                   IsHitTestVisible="False" />
                        <Border Grid.ColumnSpan="2"
                                Margin="2"
                                BorderBrush="{DynamicResource Chrono_VanillaCream}"
                                BorderThickness="2"
                                CornerRadius="5"
                                IsHitTestVisible="False" />
                        <Border Grid.ColumnSpan="2"
                                Margin="5"
                                BorderBrush="{DynamicResource Chrono_Sand}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Opacity="0.36"
                                IsHitTestVisible="False" />
                        <Button Visibility="{Binding RunningVisibility}"
                                Command="{Binding PauseCommand}"
                                IsEnabled="{Binding CanPause}"
                                Style="{StaticResource GalapagOS.Button.PrimaryPaper}"
                                Width="160"
                                Height="44"
                                Padding="8,5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource GalapagOS.Icon.Pause}"
                                      Width="15"
                                      Height="19"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Chrono_VanillaCream}"
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      Margin="0,0,8,0" />
                                <TextBlock Text="PAUSE"
                                           FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Chrono_VanillaCream}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Visibility="{Binding PausedVisibility}"
                                Command="{Binding ResumeCommand}"
                                IsEnabled="{Binding CanResume}"
                                Style="{StaticResource GalapagOS.Button.PrimaryPaper}"
                                Width="160"
                                Height="44"
                                Padding="8,5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource GalapagOS.Icon.Play}"
                                      Width="15"
                                      Height="19"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Chrono_VanillaCream}"
                                      StrokeThickness="2"
                                      Fill="Transparent"
                                      Margin="0,0,8,0" />
                                <TextBlock Text="RESUME"
                                           FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Chrono_VanillaCream}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                                Content="END"
                                Command="{Binding EndCommand}"
                                IsEnabled="{Binding CanEnd}"
                                Style="{StaticResource GalapagOS.Button.SecondaryPaper}"
                                Width="100"
                                Height="44"
                                FontSize="13"
                                Padding="7,4" />
                    </Grid>
                </Border>

                <Border Visibility="{Binding BoardVisibility}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Width="274"
                        Height="64"
                        Margin="0,0,302,0"
                        Padding="10,6"
                        Background="{DynamicResource Chrono_LightCream}"
                        BorderBrush="{DynamicResource Chrono_Sand}"
                        BorderThickness="2"
                        CornerRadius="8">
                    <Grid>
                        <Image Source="{StaticResource GalapagOS.Image.Simulation.PaperTexture}"
                               Stretch="UniformToFill"
                               Opacity="0.34"
                               IsHitTestVisible="False" />
                        <Rectangle Fill="{StaticResource GalapagOS.Brush.PaperRules}"
                                   Opacity="0.10"
                                   IsHitTestVisible="False" />
                        <Border Margin="2"
                                BorderBrush="{DynamicResource Chrono_VanillaCream}"
                                BorderThickness="2"
                                CornerRadius="5"
                                IsHitTestVisible="False" />
                        <Border Margin="5"
                                BorderBrush="{DynamicResource Chrono_Sand}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Opacity="0.36"
