<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:game="clr-namespace:SaltyGame">

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../GlobalResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BitmapImage x:Key="GalapagOS.Image.Simulation.PaperTexture"
                         UriSource="../Art/Simulation/GalapagOS_Simulation_PaperTexture_v1.png" />
            <BitmapImage x:Key="GalapagOS.Image.Simulation.SpecimenJars"
                         UriSource="../Art/Simulation/GalapagOS_Simulation_SpecimenJars_v1.png" />
            <BitmapImage x:Key="GalapagOS.Image.Simulation.BotanicalSketch"
                         UriSource="../Art/Simulation/GalapagOS_Simulation_BotanicalSketch_v1.png" />

            <!-- The cream base is applied directly. This repeating overlay only draws paper rules. -->
            <LinearGradientBrush x:Key="GalapagOS.Brush.PaperRules"
                                 StartPoint="0,0"
                                 EndPoint="0,24"
                                 MappingMode="Absolute"
                                 SpreadMethod="Repeat">
                <GradientStop Color="#00D4A373" Offset="0" />
                <GradientStop Color="#00D4A373" Offset="0.90" />
                <GradientStop Color="#FFD4A373" Offset="0.94" />
                <GradientStop Color="#00D4A373" Offset="0.98" />
                <GradientStop Color="#00D4A373" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="GalapagOS.LedgerRing" TargetType="Border">
                <Setter Property="Width" Value="21" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Background" Value="{DynamicResource Chrono_LightCream}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Chrono_TreeBark}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="5" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource Chrono_TreeBark}" />
                <Setter Property="Background" Value="{DynamicResource Chrono_VanillaCream}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Chrono_Sand}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="6,4" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{DynamicResource Chrono_TreeBark}" />
                <Setter Property="Background" Value="{DynamicResource Chrono_VanillaCream}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Chrono_Sand}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="6,4" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource Chrono_TreeBark}" />
                <Setter Property="FontFamily" Value="{DynamicResource GalapagOS.FontFamily.Primary}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="SimulationRewardCardText" TargetType="TextBlock">
                <Setter Property="Width" Value="210" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="{DynamicResource GalapagOS.FontFamily.Primary}" />
                <Setter Property="Foreground" Value="{DynamicResource Chrono_TreeBark}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Simulation-only visuals stay local to this shell. -->
            <ControlTemplate x:Key="GalapagOS_SegmentedProgressBarTemplate" TargetType="ProgressBar">
                <Grid x:Name="SegmentedProgressRoot" MinHeight="22">
                    <Border x:Name="PART_Track"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <Grid IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1" BorderBrush="{DynamicResource Chrono_LightCream}" BorderThickness="1,0,0,0" />
                                <Border Grid.Column="2" BorderBrush="{DynamicResource Chrono_LightCream}" BorderThickness="1,0,0,0" />
                                <Border Grid.Column="3" BorderBrush="{DynamicResource Chrono_LightCream}" BorderThickness="1,0,0,0" />
                                <Border Grid.Column="4" BorderBrush="{DynamicResource Chrono_LightCream}" BorderThickness="1,0,0,0" />
                                <Border Grid.Column="5" BorderBrush="{DynamicResource Chrono_LightCream}" BorderThickness="1,0,0,0" />
                                <Border Grid.Column="6" BorderBrush="{DynamicResource Chrono_LightCream}" BorderThickness="1,0,0,0" />
                                <Border Grid.Column="7" BorderBrush="{DynamicResource Chrono_LightCream}" BorderThickness="1,0,0,0" />
                            </Grid>
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left"
                                    CornerRadius="7" />
                        </Grid>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.45" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="GalapagOS.ProgressBar.Segmented" TargetType="ProgressBar">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Background" Value="{DynamicResource Chrono_VanillaCream}" />
                <Setter Property="Foreground" Value="{DynamicResource Chrono_Olive}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GalapagOS.Window.BorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Template" Value="{StaticResource GalapagOS_SegmentedProgressBarTemplate}" />
            </Style>

            <ControlTemplate x:Key="GalapagOS_ResearchCardTemplate" TargetType="ContentControl">
                <Border Background="{DynamicResource Chrono_LightCream}"
                        BorderBrush="{DynamicResource Chrono_Sand}"
                        BorderThickness="2"
                        CornerRadius="5"
                        Padding="5">
                    <Grid ClipToBounds="True">
                        <Image Source="{StaticResource GalapagOS.Image.Simulation.PaperTexture}"
                               Stretch="UniformToFill"
                               Opacity="0.34"
                               IsHitTestVisible="False" />
                        <Border Margin="1"
                                BorderBrush="{DynamicResource Chrono_VanillaCream}"
                                BorderThickness="1"
                                CornerRadius="3"
                                IsHitTestVisible="False" />
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="{Binding (game:GalapagOSMetricRow.IconSource), RelativeSource={RelativeSource TemplatedParent}}"
                                   Width="28"
                                   Height="28"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding (game:GalapagOSMetricRow.Label), RelativeSource={RelativeSource TemplatedParent}}"
                                       Margin="0,3,0,0"
                                       HorizontalAlignment="Center"
                                       FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{TemplateBinding Foreground}" />
                            <TextBlock Text="{Binding (game:GalapagOSMetricRow.Value), RelativeSource={RelativeSource TemplatedParent}}"
                                       Margin="0,2,0,0"
                                       HorizontalAlignment="Center"
                                       FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>

            <Style x:Key="GalapagOS.ResearchCard" TargetType="ContentControl">
                <Setter Property="Width" Value="72" />
                <Setter Property="Height" Value="82" />
                <Setter Property="Foreground" Value="{DynamicResource Chrono_TreeBark}" />
                <Setter Property="Template" Value="{StaticResource GalapagOS_ResearchCardTemplate}" />
            </Style>

            <ControlTemplate x:Key="GalapagOS_SpeedRadioButtonTemplate" TargetType="RadioButton">
                <Border x:Name="SpeedRadioSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5">
                    <Grid ClipToBounds="True">
                        <Image Source="{StaticResource GalapagOS.Image.Simulation.PaperTexture}"
                               Stretch="UniformToFill"
                               Opacity="0.30"
                               IsHitTestVisible="False" />
                        <Border Margin="2"
                                BorderBrush="{DynamicResource Chrono_VanillaCream}"
                                BorderThickness="1,1,0,0"
                                CornerRadius="3"
                                IsHitTestVisible="False" />
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{DynamicResource GalapagOS.Button.Primary.Background}" />
                        <Setter Property="Foreground" Value="{DynamicResource GalapagOS.Button.Primary.Foreground}" />
                        <Setter TargetName="SpeedRadioSurface" Property="BorderBrush" Value="{DynamicResource GalapagOS.Window.BorderBrush}" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="SpeedRadioSurface" Property="Opacity" Value="0.9" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="SpeedRadioSurface" Property="Opacity" Value="0.45" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="GalapagOS.RadioButton.Speed" TargetType="RadioButton">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Background" Value="{DynamicResource GalapagOS.Button.Secondary.Background}" />
                <Setter Property="Foreground" Value="{DynamicResource GalapagOS.Button.Secondary.Foreground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GalapagOS.Window.BorderBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="11,7" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="FontFamily" Value="{DynamicResource GalapagOS.FontFamily.Primary}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template" Value="{StaticResource GalapagOS_SpeedRadioButtonTemplate}" />
            </Style>

            <ControlTemplate x:Key="GalapagOS_PaperButtonTemplate" TargetType="Button">
                <Border x:Name="PaperButtonSurface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                    <Grid ClipToBounds="True">
                        <Image Source="{StaticResource GalapagOS.Image.Simulation.PaperTexture}"
                               Stretch="UniformToFill"
                               Opacity="0.34"
                               IsHitTestVisible="False" />
                        <Border Margin="2"
                                BorderBrush="{DynamicResource Chrono_VanillaCream}"
                                BorderThickness="1,1,0,0"
                                CornerRadius="4"
                                IsHitTestVisible="False" />
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="PaperButtonSurface" Property="Opacity" Value="0.90" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="PaperButtonSurface" Property="Opacity" Value="0.76" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="PaperButtonSurface" Property="Opacity" Value="0.45" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="GalapagOS.Button.PrimaryPaper"
                   TargetType="Button"
                   BasedOn="{StaticResource GalapagOS.Button.Primary}">
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Template" Value="{StaticResource GalapagOS_PaperButtonTemplate}" />
            </Style>

            <Style x:Key="GalapagOS.Button.SecondaryPaper"
                   TargetType="Button"
                   BasedOn="{StaticResource GalapagOS.Button.Secondary}">
                <Setter Property="Template" Value="{StaticResource GalapagOS_PaperButtonTemplate}" />
            </Style>

            <Style x:Key="GalapagOS.Button.RewardCard"
                   TargetType="Button"
                   BasedOn="{StaticResource GalapagOS.Button.SecondaryPaper}">
                <Setter Property="Background" Value="{DynamicResource Chrono_VanillaCream}" />
                <Setter Property="Foreground" Value="{DynamicResource Chrono_TreeBark}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Chrono_Olive}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="GalapagOS.Button.FieldNotes" TargetType="Button" BasedOn="{StaticResource GalapagOS.Button.SecondaryPaper}">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <DataTemplate x:Key="GalapagOS_TimelineItemTemplate">
                <Grid Width="72" Height="42">
                    <Rectangle Grid.ColumnSpan="2"
                               Width="48"
                               Height="2"
                               Margin="20,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource Chrono_Olive}" />
                    <Rectangle Grid.ColumnSpan="2"
                               Width="48"
                               Height="2"
                               Margin="20,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Fill="Transparent"
                               Stroke="{DynamicResource Chrono_Sand}"
                               StrokeDashArray="6,4"
                               StrokeThickness="2"
                               Visibility="{Binding DottedConnectorVisibility}" />
                    <Grid Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource Chrono_LightCream}"
                                 Stroke="{DynamicResource Chrono_Sand}"
                                 StrokeThickness="2" />
                        <Ellipse Fill="{DynamicResource Chrono_Lime}"
                                 Stroke="{DynamicResource Chrono_Olive}"
                                 StrokeThickness="2"
                                 Visibility="{Binding ActivePipVisibility}" />
                        <Ellipse Fill="{DynamicResource Chrono_Olive}"
                                 Stroke="{DynamicResource GalapagOS.Window.BorderBrush}"
                                 StrokeThickness="2"
                                 Visibility="{Binding CompletePipVisibility}" />
                        <TextBlock Text="{Binding Label}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Chrono_TreeBark}" />
                    </Grid>
                    <Rectangle Width="48"
                               Height="2"
                               Margin="20,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource Chrono_Olive}"
                               Visibility="{Binding SolidConnectorVisibility}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="GalapagOS_TimelineCompactItemTemplate">
                <Grid Width="22" Height="24">
                    <Rectangle Width="7"
                               Height="2"
                               Margin="15,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Fill="{DynamicResource Chrono_Olive}"
                               Visibility="{Binding SolidConnectorVisibility}" />
                    <Rectangle Width="7"
                               Height="2"
                               Margin="15,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Fill="Transparent"
                               Stroke="{DynamicResource Chrono_Sand}"
                               StrokeDashArray="3,2"
                               StrokeThickness="1"
                               Visibility="{Binding DottedConnectorVisibility}" />
                    <Ellipse Width="18"
                             Height="18"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource Chrono_LightCream}"
                             Stroke="{DynamicResource Chrono_Sand}"
                             StrokeThickness="2" />
                    <Ellipse Width="18"
                             Height="18"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource Chrono_Lime}"
                             Stroke="{DynamicResource Chrono_Olive}"
                             StrokeThickness="2"
                             Visibility="{Binding ActivePipVisibility}" />
                    <Ellipse Width="18"
                             Height="18"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource Chrono_Olive}"
                             Stroke="{DynamicResource GalapagOS.Window.BorderBrush}"
                             StrokeThickness="2"
                             Visibility="{Binding CompletePipVisibility}" />
                </Grid>
            </DataTemplate>

            <Style x:Key="GalapagOS.Timeline" TargetType="ItemsControl">
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemTemplate" Value="{StaticResource GalapagOS_TimelineItemTemplate}" />
            </Style>
</ResourceDictionary>
