<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:game="clr-namespace:SaltyGame"
             xmlns:noesis="clr-namespace:NoesisApp;assembly=Noesis.NoesisGUI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../GlobalResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource Chrono_TreeBark}" />
                <Setter Property="Background" Value="{DynamicResource Chrono_VanillaCream}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Chrono_Sand}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="6,4" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{DynamicResource Chrono_TreeBark}" />
                <Setter Property="Background" Value="{DynamicResource Chrono_VanillaCream}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Chrono_Sand}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="6,4" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource Chrono_TreeBark}" />
                <Setter Property="FontFamily" Value="{DynamicResource GalapagOS.FontFamily.Primary}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="Both">
    <Grid Width="1280"
          Height="720"
          Margin="24">
        <HeaderedContentControl x:Name="SimulationWindow"
                                Header="ECOLOGY SIMULATION"
                                game:GalapagOSWindow.IconSource="../../GalapagOS/Art/Icons/GalapagOS_Icon_Sprout.png"
                                game:GalapagOSWindow.CloseCommand="{Binding CloseWindowCommand}"
                                game:GalapagOSWindow.CloseEnabled="{Binding CanCloseWindow}"
                                Style="{StaticResource GalapagOS_HeaderedWindowStyle}">
            <Grid>
                <Border HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Padding="12,7"
                        Background="{DynamicResource Chrono_Lime}"
                        BorderBrush="{DynamicResource Chrono_Olive}"
                        BorderThickness="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ECOLOGY FIELD VIEW"
                                       Foreground="{DynamicResource Chrono_TreeBark}"
                                       FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                       FontSize="11"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding ScenarioText}"
                                       Foreground="{DynamicResource Chrono_TreeBark}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="{Binding StateTitle}"
                                       Foreground="{DynamicResource Chrono_TreeBark}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding PlayerSpeciesText}"
                                       Foreground="{DynamicResource Chrono_Olive}"
                                       FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Margin="0,2,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="{Binding CurrencyText}"
                                       Foreground="{DynamicResource Chrono_TreeBark}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding RosterText}"
                                       Foreground="{DynamicResource Chrono_TreeBark}"
                                       FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Visibility="{Binding BoardVisibility}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Margin="18,68,302,56"
                      Padding="10"
                      Background="{DynamicResource Chrono_VanillaCream}"
                      BorderBrush="{DynamicResource Chrono_Olive}"
                      BorderThickness="3"
                      CornerRadius="8"
                      ClipToBounds="True">
                    <Grid>
                        <game:SpeciesSimulationBoard x:Name="SimulationBoard"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch">
                            <b:Interaction.Behaviors>
                                <noesis:TranslateZoomRotateBehavior SupportedGestures="All"
                                                                     MinimumScale="0.75"
                                                                     MaximumScale="4"
                                                                     WheelSensitivity="0.15"
                                                                     ConstrainToParentBounds="True"/>
                            </b:Interaction.Behaviors>
                        </game:SpeciesSimulationBoard>
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="10"
                                Padding="8,5"
                                Background="{DynamicResource Chrono_LightCream}"
                                BorderBrush="{DynamicResource Chrono_Sand}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Opacity="0.92">
                            <TextBlock Text="FIELD OBSERVATION BOARD  ·  DRAG TO EXPLORE"
                                       FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Chrono_TreeBark}" />
                        </Border>
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="10"
                                Padding="8,5"
                                Background="{DynamicResource Chrono_LightCream}"
                                BorderBrush="{DynamicResource Chrono_Sand}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Opacity="0.92">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Chrono_Olive}" Margin="0,0,5,0" />
                                <TextBlock Text="PLAYER SPECIES"
                                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Chrono_TreeBark}" />
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Chrono_GoldenPollen}" Margin="12,0,5,0" />
                                <TextBlock Text="RESOURCE"
                                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Chrono_TreeBark}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Visibility="{Binding BoardVisibility}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="264"
                        Margin="0,68,18,0"
                        Padding="12"
                        Background="{DynamicResource Chrono_LightCream}"
                        BorderBrush="{DynamicResource Chrono_Sand}"
                        BorderThickness="2"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="FIELD LEDGER"
                                   FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Chrono_Olive}" />
                        <TextBlock Text="{Binding RunStatusText}"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource Chrono_TreeBark}"
                                   FontSize="17"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding RunDetailsText}"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource Chrono_TreeBark}"
                                   FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                        <Rectangle Height="1"
                                   Margin="0,10,0,8"
                                   Fill="Transparent"
                                   Stroke="{DynamicResource Chrono_Sand}"
                                   StrokeDashArray="7,4"
                                   StrokeThickness="1" />
                        <TextBlock Text="ROSTER"
                                   FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Chrono_Olive}" />
                        <TextBlock Text="{Binding RosterText}"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource Chrono_TreeBark}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CurrencyText}"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource Chrono_Olive}"
                                   FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                   FontSize="10"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>

        <Border Visibility="{Binding SettingsVisibility}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="28,88,0,0"
                Width="620"
                Height="608"
                Padding="18"
                Background="{DynamicResource Chrono_VanillaCream}"
                BorderBrush="{DynamicResource Chrono_Olive}"
                BorderThickness="3"
                CornerRadius="10">
            <ScrollViewer Height="572"
                          VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="PREPARE THE NEXT EXPEDITION"
                           Foreground="{DynamicResource Chrono_TreeBark}"
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                           FontSize="23"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock Text="Select a habitat and species, then issue the launch permit."
                           Foreground="{DynamicResource Chrono_Olive}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,12"/>
                <CheckBox Content="DEVELOPER MODE — SHOW SIMULATION DASHBOARD"
                          IsChecked="{Binding DeveloperMode, Mode=TwoWay}"
                          Foreground="{DynamicResource Chrono_Olive}"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"/>
                <StackPanel Visibility="{Binding PlayerSettingsVisibility}">
                    <TextBlock Text="Choose a scenario, then start your expedition. Advanced simulation tuning is available in Developer Mode."
                               Foreground="{DynamicResource Chrono_Olive}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="Scenario" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding ScenarioOptions}"
                                  SelectedIndex="{Binding SelectedScenarioIndex, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditSettings}"
                                  Width="300"
                                  Height="34"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="Player species" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding PlayerSpeciesOptions}"
                                  SelectedIndex="{Binding SelectedPlayerSpeciesIndex, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditSettings}"
                                  Width="300"
                                  Height="34"/>
                    </StackPanel>
                    <TextBlock Text="{Binding RosterText}"
                               Foreground="{DynamicResource Chrono_TreeBark}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,8,0,4"/>
                </StackPanel>
                <ScrollViewer Height="270"
                              Visibility="{Binding DeveloperSettingsVisibility}"
                              IsEnabled="{Binding CanEditSettings}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Scenario" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding ScenarioOptions}"
                                      SelectedIndex="{Binding SelectedScenarioIndex, Mode=TwoWay}"
                                      IsEnabled="{Binding CanEditSettings}"
                                      Width="300"
                                      Height="34"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Grid width" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding GridWidthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Grid height" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding GridHeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Base seed" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding BaseSeedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Maximum population" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding MaximumPopulationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Minimum population" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding MinimumPopulationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Run ticks (single-run mode)" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding RunTicksText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <CheckBox Content="Use continuous phases (default)"
                                  IsChecked="{Binding ContinuousPhasesEnabled, Mode=TwoWay}"
                                  Foreground="{DynamicResource Chrono_TreeBark}"
                                  Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Continuous phase (ticks)" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding PhaseLengthTicksText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <TextBlock Text="Continuous mode runs 10 phases. Phase length controls each simulation; run ticks is used only in Developer single-run mode."
                                   Foreground="{DynamicResource Chrono_Olive}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Step interval (seconds)" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding StepIntervalText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Plant start chance" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding PlantProbabilityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Herbivore start chance" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding HerbivoreProbabilityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Carnivore start chance" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding CarnivoreProbabilityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <CheckBox Content="Randomize seed on start"
                                  IsChecked="{Binding RandomizeSeedOnStart, Mode=TwoWay}"
                                  Foreground="{DynamicResource Chrono_TreeBark}"
                                  Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Text="{Binding SelectedRuleSpeciesTitle}"
                           Visibility="{Binding DeveloperSettingsVisibility}"
                           Foreground="{DynamicResource Chrono_Olive}"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,4"/>
                <ComboBox ItemsSource="{Binding SpeciesTabs}"
                          Visibility="{Binding DeveloperSettingsVisibility}"
                          SelectedIndex="{Binding SelectedRuleSpeciesIndex, Mode=TwoWay}"
                          IsEnabled="{Binding CanEditSettings}"
                          Height="34"
                          Margin="0,0,0,6"/>
                <ScrollViewer Height="390"
                              Visibility="{Binding DeveloperSettingsVisibility}"
                              IsEnabled="{Binding CanEditSettings}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <CheckBox Content="Movement enabled" IsChecked="{Binding MovementEnabled, Mode=TwoWay}" Foreground="{DynamicResource Chrono_TreeBark}" Margin="0,3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Movement speed" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding MovementSpeedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Movement pattern" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding MovementPattern, Mode=TwoWay}" Width="140">
                                <ComboBoxItem Content="Cardinal"/>
                                <ComboBoxItem Content="Moore"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox Content="Attack enabled" IsChecked="{Binding AttackEnabled, Mode=TwoWay}" Foreground="{DynamicResource Chrono_TreeBark}" Margin="0,3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Attack amount" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding AttackAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Attack pattern" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding AttackPattern, Mode=TwoWay}" Width="140">
                                <ComboBoxItem Content="Cardinal"/>
                                <ComboBoxItem Content="Moore"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Block amount" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding BlockAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Block pattern" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding BlockPattern, Mode=TwoWay}" Width="140">
                                <ComboBoxItem Content="Cardinal"/>
                                <ComboBoxItem Content="Moore"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Diet target" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding DietTarget, Mode=TwoWay}" Width="140">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="Plant"/>
                                <ComboBoxItem Content="Herbivore"/>
                                <ComboBoxItem Content="Carnivore"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Diet pattern" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding DietPattern, Mode=TwoWay}" Width="140">
                                <ComboBoxItem Content="Cardinal"/>
                                <ComboBoxItem Content="Moore"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Reproduction pattern" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding ReproductionPattern, Mode=TwoWay}" Width="140">
                                <ComboBoxItem Content="Cardinal"/>
                                <ComboBoxItem Content="Moore"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox Content="Reproduction enabled" IsChecked="{Binding ReproductionEnabled, Mode=TwoWay}" Foreground="{DynamicResource Chrono_TreeBark}" Margin="0,3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Reproduction chance" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding ReproductionChanceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Nearby mate requirement" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding ReproductionNeighborCountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Energy transferred to offspring" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding ReproductionFoodRequiredText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Maximum group size" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding MaxReproductionGroupSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Starting energy" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding StartingEnergyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Maximum energy reserve" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding MaximumEnergyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Minimum litter size" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding LitterMinimumText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Maximum litter size" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding LitterMaximumText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Forage at or below energy" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding ForageBelowEnergyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Energy value" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding EnergyValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Metabolism (- adds)" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding MetabolismText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Vision range" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding VisionRangeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Intelligence" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding IntelligenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <CheckBox Content="Wilt enabled" IsChecked="{Binding WiltEnabled, Mode=TwoWay}" Foreground="{DynamicResource Chrono_TreeBark}" Margin="0,3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Wilt chance" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding WiltChanceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Crowding cost" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding CrowdingEnergyPenaltyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Starting food reserve" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding StartingFoodReserveText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                        <CheckBox Content="Seed drops enabled" IsChecked="{Binding SeedDropEnabled, Mode=TwoWay}" Foreground="{DynamicResource Chrono_TreeBark}" Margin="0,3"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="Seed drop chance" Foreground="{DynamicResource Chrono_TreeBark}" Width="250" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SeedDropChanceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Visibility="{Binding DeveloperSettingsVisibility}"
                            IsEnabled="{Binding CanEditSettings}"
                            Margin="0,10,0,0">
                    <TextBlock Text="BEV EXPERIMENTAL FEATURES"
                               Foreground="{DynamicResource Chrono_Olive}"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,2"/>
                    <CheckBox Content="Enable Bev experimental combat and species stat lines"
                              IsChecked="{Binding BevExperimentalFeaturesEnabled, Mode=TwoWay}"
                              Foreground="{DynamicResource Chrono_TreeBark}"
                              Margin="0,3,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="Fox attack cooldown (ticks; 0 = off)"
                                   Foreground="{DynamicResource Chrono_TreeBark}"
                                   Width="250"
                                   VerticalAlignment="Center"/>
                        <TextBox Text="{Binding FoxAttackCooldownTicksText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="120"/>
                    </StackPanel>
                    <TextBlock Text="Leave this unchecked to keep the legacy combat rules. Apply Settings before starting."
                               Foreground="{DynamicResource Chrono_Olive}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="APPLY SPECIES RULES"
                        Visibility="{Binding DeveloperSettingsVisibility}"
                        Command="{Binding ApplySpeciesRulesCommand}"
                        IsEnabled="{Binding CanEditSettings}"
                        Style="{StaticResource GalapagOS.Button.Primary}"
                        Height="40"
                        Margin="0,8,0,0"/>
                <TextBlock Text="{Binding SettingsMessage}"
                           Foreground="{DynamicResource Chrono_Tangerine}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="APPLY SETTINGS"
                            Visibility="{Binding DeveloperSettingsVisibility}"
                            Command="{Binding ApplySettingsCommand}"
                            IsEnabled="{Binding CanEditSettings}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="180"
                            Height="42"
                            Margin="0,0,8,0"/>
                    <Button Content="SAVE DEFAULT"
                            Visibility="{Binding DeveloperSettingsVisibility}"
                            Command="{Binding SaveSettingsCommand}"
                            IsEnabled="{Binding CanEditSettings}"
                            Style="{StaticResource GalapagOS.Button.Secondary}"
                            Width="150"
                            Height="42"
                            Margin="0,0,8,0"/>
                    <Button Content="START"
                            Command="{Binding StartCommand}"
                            IsEnabled="{Binding CanStart}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="100"
                            Height="42"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Visibility="{Binding RunningVisibility}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Width="340"
                Margin="0,0,28,26"
                Padding="18"
                Background="{DynamicResource Chrono_LightCream}"
                BorderBrush="{DynamicResource Chrono_Olive}"
                BorderThickness="3"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="LIVE FIELD CONTROLS"
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Chrono_Olive}" />
                <TextBlock Text="{Binding RunStatusText}"
                           Foreground="{DynamicResource Chrono_Olive}"
                           FontSize="18"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding RunDetailsText}"
                           Foreground="{DynamicResource Chrono_TreeBark}"
                           FontSize="14"
                           Margin="0,6,0,14"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="PAUSE"
                            Command="{Binding PauseCommand}"
                            IsEnabled="{Binding CanPause}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="92"
                            Height="42"
                            Margin="0,0,8,0"/>
                    <Button Content="RESTART"
                            Command="{Binding RestartCommand}"
                            IsEnabled="{Binding CanRestart}"
                            Style="{StaticResource GalapagOS.Button.Secondary}"
                            Width="102"
                            Height="42"
                            Margin="0,0,8,0"/>
                    <Button Content="STOP"
                            Command="{Binding StopCommand}"
                            IsEnabled="{Binding CanStop}"
                            Style="{StaticResource GalapagOS.Button.Secondary}"
                            Width="74"
                            Height="42"/>
                </StackPanel>
                <Button Content="END"
                        Command="{Binding EndCommand}"
                        IsEnabled="{Binding CanEnd}"
                        Style="{StaticResource GalapagOS.Button.Secondary}"
                        Width="74"
                        Height="42"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Border Visibility="{Binding PausedVisibility}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Width="340"
                Margin="0,0,28,26"
                Padding="18"
                Background="{DynamicResource Chrono_VanillaCream}"
                BorderBrush="{DynamicResource Chrono_Tangerine}"
                BorderThickness="3"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="FIELD NOTE · PAUSED"
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Chrono_Tangerine}" />
                <TextBlock Text="SIMULATION PAUSED"
                           Foreground="{DynamicResource Chrono_Tangerine}"
                           FontSize="18"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding RunDetailsText}"
                           Foreground="{DynamicResource Chrono_TreeBark}"
                           FontSize="14"
                           Margin="0,6,0,14"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="RESUME"
                            Command="{Binding ResumeCommand}"
                            IsEnabled="{Binding CanResume}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="105"
                            Height="42"
                            Margin="0,0,8,0"/>
                    <Button Content="RESTART"
                            Command="{Binding RestartCommand}"
                            IsEnabled="{Binding CanRestart}"
                            Style="{StaticResource GalapagOS.Button.Secondary}"
                            Width="102"
                            Height="42"
                            Margin="0,0,8,0"/>
                    <Button Content="STOP"
                            Command="{Binding StopCommand}"
                            IsEnabled="{Binding CanStop}"
                            Style="{StaticResource GalapagOS.Button.Secondary}"
                            Width="74"
                            Height="42"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Visibility="{Binding PhaseDecisionVisibility}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="820"
                Padding="32"
                Background="{DynamicResource Chrono_LightCream}"
                BorderBrush="{DynamicResource Chrono_Olive}"
                BorderThickness="3"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="RESEARCH NOTE · PHASE BOUNDARY"
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Chrono_Olive}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="PHASE COMPLETE"
                           Foreground="{DynamicResource Chrono_Olive}"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="The world is frozen at the phase boundary. Spend phase data on one live upgrade, or skip and keep going."
                           Foreground="{DynamicResource Chrono_TreeBark}"
                           FontSize="16"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,12,0,12"/>
                <TextBlock Text="{Binding PhaseRewardText}"
                           Foreground="{DynamicResource Chrono_Olive}"
                           FontSize="14"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,12"/>
                <TextBlock Text="{Binding RunDetailsText}"
                           Foreground="{DynamicResource Chrono_TreeBark}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Command="{Binding PurchaseRewardOption1Command}"
                            IsEnabled="{Binding CanPurchaseRewardOption1}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="240"
                            Height="112"
                            Margin="0,0,10,0">
                        <TextBlock Text="{Binding RewardOption1Text}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding PurchaseRewardOption2Command}"
                            IsEnabled="{Binding CanPurchaseRewardOption2}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="240"
                            Height="112"
                            Margin="0,0,10,0">
                        <TextBlock Text="{Binding RewardOption2Text}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding PurchaseRewardOption3Command}"
                            IsEnabled="{Binding CanPurchaseRewardOption3}"
                            Visibility="{Binding RewardOption3Visibility}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="240"
                            Height="112">
                        <TextBlock Text="{Binding RewardOption3Text}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="SKIP / CONTINUE"
                            Command="{Binding ContinueWithoutUpgradeCommand}"
                            IsEnabled="{Binding CanContinueWithoutUpgrade}"
                            Style="{StaticResource GalapagOS.Button.Secondary}"
                            Width="166"
                            Height="50"
                            Margin="0,0,8,0"/>
                    <Button Content="RESTART"
                            Command="{Binding RestartCommand}"
                            IsEnabled="{Binding CanRestart}"
                            Style="{StaticResource GalapagOS.Button.Secondary}"
                            Width="102"
                            Height="50"
                            Margin="0,0,8,0"/>
                    <Button Content="STOP"
                            Command="{Binding StopCommand}"
                            IsEnabled="{Binding CanStop}"
                            Style="{StaticResource GalapagOS.Button.Secondary}"
                            Width="74"
                            Height="50"/>
                    <Button Content="END"
                            Command="{Binding EndCommand}"
                            IsEnabled="{Binding CanEnd}"
                            Style="{StaticResource GalapagOS.Button.Secondary}"
                            Width="74"
                            Height="50"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Visibility="{Binding RewardsVisibility}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="820"
                Padding="32"
                Background="{DynamicResource Chrono_LightCream}"
                BorderBrush="{DynamicResource Chrono_Olive}"
                BorderThickness="3"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="EXPEDITION NOTE · REWARD REVIEW"
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Chrono_Olive}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="SINGLE RUN COMPLETE"
                           Foreground="{DynamicResource Chrono_TreeBark}"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Choose an upgrade for your player species to carry into the next simulation."
                           Foreground="{DynamicResource Chrono_Olive}"
                           FontSize="16"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,18"/>
                <StackPanel Visibility="{Binding ExperimentalHerbivoreStatLineSummaryVisibility}"
                            Margin="0,0,0,18">
                    <TextBlock Text="BEV EXPERIMENTAL HERBIVORE STAT LINE"
                               Foreground="{DynamicResource Chrono_Olive}"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ExperimentalHerbivoreStatLineSummary}"
                               Foreground="{DynamicResource Chrono_TreeBark}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding ExperimentalUpgradeCountText}"
                           Visibility="{Binding ExperimentalUpgradeCountVisibility}"
                           Foreground="{DynamicResource Chrono_Olive}"
                           FontSize="13"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,-8,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Command="{Binding PurchaseRewardOption1Command}"
                            IsEnabled="{Binding CanPurchaseRewardOption1}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="240"
                            Height="112"
                            Margin="0,0,10,0">
                        <TextBlock Text="{Binding RewardOption1Text}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding PurchaseRewardOption2Command}"
                            IsEnabled="{Binding CanPurchaseRewardOption2}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="240"
                            Height="112"
                            Margin="0,0,10,0">
                        <TextBlock Text="{Binding RewardOption2Text}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding PurchaseRewardOption3Command}"
                            IsEnabled="{Binding CanPurchaseRewardOption3}"
                            Visibility="{Binding RewardOption3Visibility}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="240"
                            Height="112">
                        <TextBlock Text="{Binding RewardOption3Text}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Button>
                </StackPanel>
                <Button Content="CONTINUE WITHOUT UPGRADE"
                        Command="{Binding ContinueWithoutUpgradeCommand}"
                        Style="{StaticResource GalapagOS.Button.Secondary}"
                        Height="44"
                        Margin="0,14,0,0"/>
            </StackPanel>
        </Border>

        <Border Visibility="{Binding ResultsVisibility}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="520"
                Padding="28"
                Background="{DynamicResource Chrono_LightCream}"
                BorderBrush="{DynamicResource Chrono_Olive}"
                BorderThickness="3"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="FIELD REPORT · EXPEDITION SUMMARY"
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Chrono_Olive}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ResultsTitleText}"
                           Foreground="{DynamicResource Chrono_TreeBark}"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding ResultsMessageText}"
                           Foreground="{DynamicResource Chrono_Olive}"
                           FontSize="16"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,18"/>
                <TextBlock Text="{Binding SelectedUpgradeSummaryText}"
                           Foreground="{DynamicResource Chrono_Olive}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,18"/>
                <StackPanel Visibility="{Binding ExperimentalHerbivoreStatLineSummaryVisibility}"
                            Margin="0,0,0,18">
                    <TextBlock Text="BEV EXPERIMENTAL HERBIVORE STAT LINE"
                               Foreground="{DynamicResource Chrono_Olive}"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ExperimentalHerbivoreStatLineSummary}"
                               Foreground="{DynamicResource Chrono_TreeBark}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding ExperimentalUpgradeCountText}"
                           Visibility="{Binding ExperimentalUpgradeCountVisibility}"
                           Foreground="{DynamicResource Chrono_Olive}"
                           FontSize="13"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,-8,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{Binding PlayNextSimulationText}"
                            Command="{Binding PlayNextSimulationCommand}"
                            IsEnabled="{Binding CanPlayNextSimulation}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="250"
                            Height="50"
                            Margin="0,0,8,0"/>
                    <Button Content="RESET"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource GalapagOS.Button.Secondary}"
                            Width="100"
                            Height="50"/>
                </StackPanel>
                <Button Content="RETURN TO LAB"
                        Command="{Binding ReturnToLabCommand}"
                        IsEnabled="{Binding CanReturnToLab}"
                        Style="{StaticResource GalapagOS.Button.Secondary}"
                        Width="250"
                        Height="44"
                        Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
            </Grid>
        </HeaderedContentControl>
    </Grid>
    </Viewbox>
</UserControl>
