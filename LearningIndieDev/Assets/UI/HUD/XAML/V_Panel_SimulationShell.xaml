                              Foreground="{DynamicResource Chrono_TreeBark}"
                              Margin="0,3,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="Fox attack cooldown (ticks; 0 = off)"
                                   Foreground="{DynamicResource Chrono_TreeBark}"
                                   Width="250"
                                   VerticalAlignment="Center"/>
                        <TextBox Text="{Binding FoxAttackCooldownTicksText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="120"/>
                    </StackPanel>
                    <TextBlock Text="Leave this unchecked to keep the legacy combat rules. Apply Settings before starting."
                               Foreground="{DynamicResource Chrono_Olive}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="APPLY SPECIES RULES"
                        Visibility="{Binding DeveloperSettingsVisibility}"
                        Command="{Binding ApplySpeciesRulesCommand}"
                        IsEnabled="{Binding CanEditSettings}"
                        Style="{StaticResource GalapagOS.Button.Primary}"
                        Height="40"
                        Margin="0,8,0,0"/>
                <TextBlock Text="{Binding SettingsMessage}"
                           Foreground="{DynamicResource Chrono_Tangerine}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="APPLY SETTINGS"
                            Visibility="{Binding DeveloperSettingsVisibility}"
                            Command="{Binding ApplySettingsCommand}"
                            IsEnabled="{Binding CanEditSettings}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="180"
                            Height="42"
                            Margin="0,0,8,0"/>
                    <Button Content="SAVE DEFAULT"
                            Visibility="{Binding DeveloperSettingsVisibility}"
                            Command="{Binding SaveSettingsCommand}"
                            IsEnabled="{Binding CanEditSettings}"
                            Style="{StaticResource GalapagOS.Button.Secondary}"
                            Width="150"
                            Height="42"
                            Margin="0,0,8,0"/>
                    <Button Content="START"
                            Command="{Binding StartCommand}"
                            IsEnabled="{Binding CanStart}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="100"
                            Height="42"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Visibility="{Binding PhaseDecisionVisibility}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="820"
                Padding="32"
                Background="{DynamicResource Chrono_LightCream}"
                BorderBrush="{DynamicResource Chrono_Olive}"
                BorderThickness="3"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="RESEARCH NOTE · PHASE BOUNDARY"
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Chrono_Olive}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="PHASE COMPLETE"
                           Foreground="{DynamicResource Chrono_Olive}"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="The world is frozen at the phase boundary. Spend phase data on one live upgrade, or skip and keep going."
                           Foreground="{DynamicResource Chrono_TreeBark}"
                           FontSize="16"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,12,0,12"/>
                <TextBlock Text="{Binding PhaseRewardText}"
                           Foreground="{DynamicResource Chrono_Olive}"
                           FontSize="14"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,12"/>
                <TextBlock Text="{Binding RunDetailsText}"
                           Foreground="{DynamicResource Chrono_TreeBark}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,18"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Command="{Binding PurchaseRewardOption1Command}"
                            IsEnabled="{Binding CanPurchaseRewardOption1}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="240"
                            Height="112"
                            Margin="0,0,10,0">
                        <TextBlock Text="{Binding RewardOption1Text}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding PurchaseRewardOption2Command}"
                            IsEnabled="{Binding CanPurchaseRewardOption2}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="240"
                            Height="112"
                            Margin="0,0,10,0">
                        <TextBlock Text="{Binding RewardOption2Text}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding PurchaseRewardOption3Command}"
                            IsEnabled="{Binding CanPurchaseRewardOption3}"
                            Visibility="{Binding RewardOption3Visibility}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="240"
                            Height="112">
                        <TextBlock Text="{Binding RewardOption3Text}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="SKIP / CONTINUE"
                            Command="{Binding ContinueWithoutUpgradeCommand}"
                            IsEnabled="{Binding CanContinueWithoutUpgrade}"
                            Style="{StaticResource GalapagOS.Button.Secondary}"
                            Width="166"
                            Height="50"
                            Margin="0,0,8,0"/>
                    <Button Content="RESTART"
                            Command="{Binding RestartCommand}"
                            IsEnabled="{Binding CanRestart}"
                            Style="{StaticResource GalapagOS.Button.Secondary}"
                            Width="102"
                            Height="50"
                            Margin="0,0,8,0"/>
                    <Button Content="STOP"
                            Command="{Binding StopCommand}"
                            IsEnabled="{Binding CanStop}"
                            Style="{StaticResource GalapagOS.Button.Secondary}"
                            Width="74"
                            Height="50"/>
                    <Button Content="END"
                            Command="{Binding EndCommand}"
                            IsEnabled="{Binding CanEnd}"
                            Style="{StaticResource GalapagOS.Button.Secondary}"
                            Width="74"
                            Height="50"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Visibility="{Binding RewardsVisibility}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="820"
                Padding="32"
                Background="{DynamicResource Chrono_LightCream}"
                BorderBrush="{DynamicResource Chrono_Olive}"
                BorderThickness="3"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="EXPEDITION NOTE · REWARD REVIEW"
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Chrono_Olive}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="SINGLE RUN COMPLETE"
                           Foreground="{DynamicResource Chrono_TreeBark}"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Choose an upgrade for your player species to carry into the next simulation."
                           Foreground="{DynamicResource Chrono_Olive}"
                           FontSize="16"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,18"/>
                <StackPanel Visibility="{Binding ExperimentalHerbivoreStatLineSummaryVisibility}"
                            Margin="0,0,0,18">
                    <TextBlock Text="BEV EXPERIMENTAL HERBIVORE STAT LINE"
                               Foreground="{DynamicResource Chrono_Olive}"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ExperimentalHerbivoreStatLineSummary}"
                               Foreground="{DynamicResource Chrono_TreeBark}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding ExperimentalUpgradeCountText}"
                           Visibility="{Binding ExperimentalUpgradeCountVisibility}"
                           Foreground="{DynamicResource Chrono_Olive}"
                           FontSize="13"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,-8,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Command="{Binding PurchaseRewardOption1Command}"
                            IsEnabled="{Binding CanPurchaseRewardOption1}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="240"
                            Height="112"
                            Margin="0,0,10,0">
                        <TextBlock Text="{Binding RewardOption1Text}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding PurchaseRewardOption2Command}"
                            IsEnabled="{Binding CanPurchaseRewardOption2}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="240"
                            Height="112"
                            Margin="0,0,10,0">
                        <TextBlock Text="{Binding RewardOption2Text}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding PurchaseRewardOption3Command}"
                            IsEnabled="{Binding CanPurchaseRewardOption3}"
                            Visibility="{Binding RewardOption3Visibility}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="240"
                            Height="112">
                        <TextBlock Text="{Binding RewardOption3Text}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Button>
                </StackPanel>
                <Button Content="CONTINUE WITHOUT UPGRADE"
                        Command="{Binding ContinueWithoutUpgradeCommand}"
                        Style="{StaticResource GalapagOS.Button.Secondary}"
                        Height="44"
                        Margin="0,14,0,0"/>
            </StackPanel>
        </Border>

        <Border Visibility="{Binding ResultsVisibility}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="520"
                Padding="28"
                Background="{DynamicResource Chrono_LightCream}"
                BorderBrush="{DynamicResource Chrono_Olive}"
                BorderThickness="3"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="FIELD REPORT · EXPEDITION SUMMARY"
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Chrono_Olive}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ResultsTitleText}"
                           Foreground="{DynamicResource Chrono_TreeBark}"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding ResultsMessageText}"
                           Foreground="{DynamicResource Chrono_Olive}"
                           FontSize="16"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,18"/>
                <TextBlock Text="{Binding SelectedUpgradeSummaryText}"
                           Foreground="{DynamicResource Chrono_Olive}"
                           FontSize="14"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,18"/>
                <StackPanel Visibility="{Binding ExperimentalHerbivoreStatLineSummaryVisibility}"
                            Margin="0,0,0,18">
                    <TextBlock Text="BEV EXPERIMENTAL HERBIVORE STAT LINE"
                               Foreground="{DynamicResource Chrono_Olive}"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ExperimentalHerbivoreStatLineSummary}"
                               Foreground="{DynamicResource Chrono_TreeBark}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding ExperimentalUpgradeCountText}"
                           Visibility="{Binding ExperimentalUpgradeCountVisibility}"
                           Foreground="{DynamicResource Chrono_Olive}"
                           FontSize="13"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,-8,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="{Binding PlayNextSimulationText}"
                            Command="{Binding PlayNextSimulationCommand}"
                            IsEnabled="{Binding CanPlayNextSimulation}"
                            Style="{StaticResource GalapagOS.Button.Primary}"
                            Width="250"
                            Height="50"
                            Margin="0,0,8,0"/>
                    <Button Content="RESET"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource GalapagOS.Button.Secondary}"
                            Width="100"
                            Height="50"/>
                </StackPanel>
                <Button Content="{Binding ReturnDestinationText}"
                        Command="{Binding ReturnToLabCommand}"
                        IsEnabled="{Binding CanReturnToLab}"
                        Style="{StaticResource GalapagOS.Button.Secondary}"
                        Width="250"
                        Height="44"
                        Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
            </Grid>
        </HeaderedContentControl>
    </Grid>
    </Viewbox>
</UserControl>
