<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:game="clr-namespace:SaltyGame">
    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid Width="1280" Height="720" Background="#FF0A1720" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="92" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF152B36" Padding="24,16" CornerRadius="8">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="BIOLOGICAL SYSTEMS LAB"
                                   Foreground="#FFF1C27D"
                                   FontSize="24"
                                   FontWeight="Bold" />
                        <TextBlock Text="Cellular automata as a roguelike"
                                   Foreground="#FFD9E7F0"
                                   FontSize="14"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Text="FOREST EDGE STUDY"
                               Foreground="#FF8FE3A8"
                               FontSize="14"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Visibility="{Binding MainMenuVisibility}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="560"
                    Padding="40"
                    Background="#F51B2A38"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="MAIN MENU"
                               Foreground="White"
                               FontSize="34"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Observe, adapt, and shape a living system."
                               Foreground="#FFD9E7F0"
                               FontSize="17"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,28" />
                    <Button x:Name="EnterLabButton"
                            Content="ENTER LAB"
                            Command="{Binding EnterLabCommand}"
                            Width="320"
                            Height="56"
                            HorizontalAlignment="Center"
                            FontSize="20" />
                    <Button Content="SETTINGS — PROTOTYPE"
                            IsEnabled="{Binding SettingsEnabled}"
                            Width="320"
                            Height="46"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0" />
                    <Button Content="CREDITS — PROTOTYPE"
                            IsEnabled="{Binding CreditsEnabled}"
                            Width="320"
                            Height="46"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0" />
                    <Button Content="QUIT"
                            Command="{Binding QuitCommand}"
                            Width="320"
                            Height="46"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Visibility="{Binding LabVisibility}"
                    Margin="0,24,0,0"
                    Padding="24"
                    Background="#F51B2A38"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Research 120" Foreground="White" FontSize="16" Margin="0,0,24,0" />
                        <TextBlock Text="Plant 36" Foreground="#FF8FE3A8" FontSize="16" Margin="0,0,24,0" />
                        <TextBlock Text="Herbivore 48" Foreground="#FFF1C27D" FontSize="16" Margin="0,0,24,0" />
                        <TextBlock Text="Carnivore 12" Foreground="#FFFF9D9D" FontSize="16" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="8,12,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="12,20,36,0">
                            <TextBlock Text="FOREST EDGE STUDY · HARE FOCUS"
                                       Foreground="White"
                                       FontSize="24"
                                       FontWeight="Bold" />
                            <TextBlock Text="Representative data"
                                       Foreground="#FFF1C27D"
                                       FontSize="15"
                                       Margin="0,8,0,20" />
                            <TextBlock Text="Last experiment: no completed experiment in this fixture"
                                       Foreground="#FFD9E7F0"
                                       FontSize="16"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="NEXT RESEARCH"
                                       Foreground="#FFF1C27D"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12" />
                            <Button x:Name="OpenResearchButton"
                                    Content="OPEN RESEARCH"
                                    Command="{Binding OpenResearchCommand}"
                                    Height="52" />
                            <Button Content="SPECIES ARCHIVE — PROTOTYPE"
                                    IsEnabled="{Binding SpeciesArchiveEnabled}"
                                    Height="44"
                                    Margin="0,10,0,0" />
                            <Button Content="EXPEDITION SETUP — PROTOTYPE"
                                    IsEnabled="{Binding ExpeditionEnabled}"
                                    Height="44"
                                    Margin="0,8,0,0" />
                            <Button x:Name="BackToMainMenuButton"
                                    Content="BACK TO MAIN MENU"
                                    Command="{Binding BackCommand}"
                                    Height="44"
                                    Margin="0,20,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Visibility="{Binding ResearchVisibility}"
                    Margin="0,24,0,0"
                    Padding="24"
                    Background="#F51B2A38"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Research 120" Foreground="White" FontSize="16" Margin="0,0,24,0" />
                        <TextBlock Text="Plant 36" Foreground="#FF8FE3A8" FontSize="16" Margin="0,0,24,0" />
                        <TextBlock Text="Herbivore 48" Foreground="#FFF1C27D" FontSize="16" Margin="0,0,24,0" />
                        <TextBlock Text="Carnivore 12" Foreground="#FFFF9D9D" FontSize="16" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="8,12,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="460" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="12,8,28,0">
                            <TextBlock Text="RESEARCH PREVIEW"
                                       Foreground="White"
                                       FontSize="24"
                                       FontWeight="Bold" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,14">
                                <TextBlock Text="Plant" Foreground="#FFD9E7F0" FontSize="15" Margin="0,0,28,0" />
                                <TextBlock Text="HERBIVORE" Foreground="#FFF1C27D" FontSize="15" FontWeight="Bold" Margin="0,0,28,0" />
                                <TextBlock Text="Carnivore" Foreground="#FFD9E7F0" FontSize="15" />
                            </StackPanel>
                            <Button x:Name="AvailableProjectButton"
                                    Content="AVAILABLE · FORAGE ROUTE MAPPING"
                                    Command="{Binding SelectAvailableProjectCommand}"
                                    Height="58"
                                    HorizontalContentAlignment="Left"
                                    Padding="18,0" />
                            <Button Content="LOCKED · PREDATOR AVOIDANCE FIELD NOTES"
                                    Command="{Binding SelectLockedProjectCommand}"
                                    Height="58"
                                    HorizontalContentAlignment="Left"
                                    Padding="18,0"
                                    Margin="0,12,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="24"
                                Background="#FF263F4B"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedProjectTitle}"
                                           Foreground="White"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedProjectState}"
                                           Foreground="#FFF1C27D"
                                           FontSize="15"
                                           Margin="0,10,0,12" />
                                <TextBlock Text="{Binding SelectedProjectCost}"
                                           Foreground="#FFD9E7F0"
                                           FontSize="15"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedProjectPrerequisite}"
                                           Foreground="#FFD9E7F0"
                                           FontSize="15"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                                <TextBlock Text="{Binding SelectedProjectBenefit}"
                                           Foreground="#FFD9E7F0"
                                           FontSize="15"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                                <Button Content="PURCHASE — PROTOTYPE PREVIEW"
                                        IsEnabled="{Binding PurchaseEnabled}"
                                        Height="48"
                                        Margin="0,20,0,0" />
                                <TextBlock Text="Representative data · no balance mutation"
                                           Foreground="#FF8FE3A8"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0" />
                                <Button x:Name="BackButton"
                                        Content="BACK TO LAB"
                                        Command="{Binding BackCommand}"
                                        Height="44"
                                        Margin="0,20,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="0"
                    Grid.RowSpan="2"
                    Visibility="{Binding QuitConfirmationVisibility}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="520"
                    Padding="28"
                    Background="#FF263F4B"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="LEAVE THE LAB?"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="The current prototype has no active run. Quit to desktop?"
                               Foreground="#FFD9E7F0"
                               FontSize="15"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="CancelQuitButton"
                                Content="CANCEL"
                                Command="{Binding CancelQuitCommand}"
                                Width="150"
                                Height="46"
                                Margin="0,0,12,0" />
                        <Button Content="QUIT"
                                Command="{Binding ConfirmQuitCommand}"
                                Width="150"
                                Height="46" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
