<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Grid Width="1280" Height="720" Background="#FF0A1720" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="92" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF152B36" Padding="24,16" CornerRadius="8">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="BIOLOGICAL SYSTEMS LAB"
                                   Foreground="#FFF1C27D"
                                   FontSize="24"
                                   FontWeight="Bold" />
                        <TextBlock Text="Cellular automata as a roguelike"
                                   Foreground="#FFD9E7F0"
                                   FontSize="14"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Text="FOREST EDGE STUDY"
                               Foreground="#FF8FE3A8"
                               FontSize="14"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Visibility="{Binding MainMenuVisibility}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="560"
                    Padding="40"
                    Background="#F51B2A38"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="MAIN MENU"
                               Foreground="White"
                               FontSize="34"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Observe, adapt, and shape a living system."
                               Foreground="#FFD9E7F0"
                               FontSize="17"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,8" />
                    <TextBlock Text="{Binding CurrentProfileName}"
                               Foreground="#FF8FE3A8"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24" />
                    <Button Content="CONTINUE"
                            Command="{Binding ContinueCommand}"
                            IsEnabled="{Binding ContinueEnabled}"
                            Width="320"
                            Height="56"
                            HorizontalAlignment="Center"
                            FontSize="20" />
                    <Button Content="PROFILE SELECTION"
                            Command="{Binding OpenProfileSelectionCommand}"
                            Width="320"
                            Height="46"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0" />
                    <Button Content="QUIT"
                            Command="{Binding RequestQuitCommand}"
                            Width="320"
                            Height="46"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Visibility="{Binding ProfileSelectionVisibility}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="680"
                    Padding="36"
                    Background="#F51B2A38"
                    CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="PROFILE SELECTION"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Create the first profile, or select a saved profile."
                               Foreground="#FFD9E7F0"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,24" />
                    <TextBox Text="{Binding ProfileNameInput}"
                             Width="420"
                             Height="44"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,10" />
                    <Button Content="CREATE INITIAL PROFILE"
                            Command="{Binding CreateInitialProfileCommand}"
                            IsEnabled="{Binding CreateInitialProfileEnabled}"
                            Width="420"
                            Height="48"
                            HorizontalAlignment="Center" />
                    <TextBlock Text="SAVED PROFILES"
                               Foreground="#FFF1C27D"
                               FontSize="15"
                               FontWeight="Bold"
                               Margin="0,24,0,10" />
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding ProfileName}"
                                        Command="{Binding SelectCommand}"
                                        Height="44"
                                        Margin="0,0,0,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="BACK"
                            Command="{Binding CloseProfileSelectionCommand}"
                            Width="220"
                            Height="44"
                            HorizontalAlignment="Center"
                            Margin="0,18,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="0"
                    Grid.RowSpan="2"
                    Visibility="{Binding QuitConfirmationVisibility}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="520"
                    Padding="28"
                    Background="#FF263F4B"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="QUIT TO DESKTOP?"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Are you sure you want to close the game?"
                               Foreground="#FFD9E7F0"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="CANCEL"
                                Command="{Binding CancelQuitCommand}"
                                Width="150"
                                Height="46"
                                Margin="0,0,12,0" />
                        <Button Content="QUIT"
                                Command="{Binding ConfirmQuitCommand}"
                                Width="150"
                                Height="46" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
