<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Rectangle Fill="Purple" Width="500" Height="250" Margin="24"/>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Yoda Is Gay" FontSize="32" Foreground="Lime" Stroke="Black" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>            
            <Button Width="300" Height="100" 
            Content="Click if Yoda is gay" 
            Command="{Binding YodaIsGayCommand}"
            Foreground="Yellow" 
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Margin="12" FontSize="24"/>

            <TextBlock Text="Yep, Yoda's gay!" FontSize="32" Foreground="Orange" HorizontalAlignment="Center" FontWeight="Bold" Visibility="{Binding YodasSexualityVisibility, FallbackValue=Collapsed}"/>
            <ProgressBar Maximum="200" Minimum="0" Value="{Binding MyProgressBarValue}" Background="AliceBlue" Foreground="Green"/>
        </StackPanel>
    </Grid>
</UserControl>