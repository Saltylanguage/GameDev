<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
  xmlns:game="clr-namespace:SaltyGame">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="ImageResources.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <SolidColorBrush x:Key="Salty_DustyRose" Color="#FFBB848E"/>
  <SolidColorBrush x:Key="Salty_SoftGreen" Color="#FF6A9B74"/>
  <SolidColorBrush x:Key="Salty_PaleTangerine" Color="#FFD6B35B"/>
  <SolidColorBrush x:Key="Chrono_VanillaCream" Color="#FFFCEEC0"/>
  <SolidColorBrush x:Key="Chrono_LightCream" Color="#FFFAF0D6"/>
  <SolidColorBrush x:Key="Chrono_Lime" Color="#FFC5D370"/>
  <SolidColorBrush x:Key="Chrono_Olive" Color="#FF84A340"/>
  <SolidColorBrush x:Key="Chrono_TreeBark" Color="#FF372C15"/>
  <SolidColorBrush x:Key="Chrono_LightCoral" Color="#FFF08080"/>
  <SolidColorBrush x:Key="Chrono_Tangerine" Color="#FFFF9770"/>
  <SolidColorBrush x:Key="Chrono_GoldenPollen" Color="#FFFDCA47"/>
  <SolidColorBrush x:Key="Chrono_Sand" Color="#FFD4A373"/>
  <SolidColorBrush x:Key="Chrono_AzureSky" Color="#FFA2D2FF"/>
  <SolidColorBrush x:Key="Chrono_FloralRose" Color="#FFFFC8DD"/>
  <SolidColorBrush x:Key="Chrono_PaleLilac" Color="#FFCDB4DB"/>

  <!-- Pixeloid Sans includes regular and bold faces; select the latter with FontWeight="Bold". -->
  <FontFamily x:Key="GalapagOS.FontFamily.Primary">Fonts/Pixeloid/#Pixeloid Sans</FontFamily>
  <FontFamily x:Key="GalapagOS.FontFamily.Monospace">Fonts/Pixeloid/#Pixeloid Mono</FontFamily>

  <!-- Resource-driven HeaderedContentControl window defaults. Variants can override these
       semantic keys in the control's local Resources without duplicating the template. -->
  <SolidColorBrush x:Key="GalapagOS.Window.BorderBrush" Color="#FF6F7E3A"/>
  <LinearGradientBrush x:Key="GalapagOS.Window.BodyBackground" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#FFFFF9E8" Offset="0"/>
    <GradientStop Color="#FFFCEEC0" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="GalapagOS.Window.HeaderBackground" Color="#FFC5D370"/>
  <SolidColorBrush x:Key="GalapagOS.Window.HeaderForeground" Color="#FF372C15"/>
  <SolidColorBrush x:Key="GalapagOS.Window.Stripe" Color="#FFE8EDB2"/>
  <!-- Reusable three-line horizontal stripe treatment for title bands and panel headers. -->
  <LinearGradientBrush x:Key="GalapagOS.Brush.TopStripes" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#00E8EDB2" Offset="0" />
    <GradientStop Color="#00E8EDB2" Offset="0.22" />
    <GradientStop Color="#FFE8EDB2" Offset="0.22" />
    <GradientStop Color="#FFE8EDB2" Offset="0.30" />
    <GradientStop Color="#00E8EDB2" Offset="0.30" />
    <GradientStop Color="#00E8EDB2" Offset="0.44" />
    <GradientStop Color="#FFE8EDB2" Offset="0.44" />
    <GradientStop Color="#FFE8EDB2" Offset="0.52" />
    <GradientStop Color="#00E8EDB2" Offset="0.52" />
    <GradientStop Color="#00E8EDB2" Offset="0.66" />
    <GradientStop Color="#FFE8EDB2" Offset="0.66" />
    <GradientStop Color="#FFE8EDB2" Offset="0.74" />
    <GradientStop Color="#00E8EDB2" Offset="0.74" />
    <GradientStop Color="#00E8EDB2" Offset="1" />
  </LinearGradientBrush>

  <!-- Shared monochrome vector primitives. Apply GalapagOS.Icon.Path to a Path and
       provide one of these geometries through its Data property. -->
  <Geometry x:Key="GalapagOS.Icon.Play">M4,2 L21,12 L4,22 Z</Geometry>
  <Geometry x:Key="GalapagOS.Icon.Pause">M3,2 H9 V22 H3 Z M15,2 H21 V22 H15 Z</Geometry>
  <Geometry x:Key="GalapagOS.Icon.Stop">M3,3 H21 V21 H3 Z</Geometry>
  <Geometry x:Key="GalapagOS.Icon.ZoomIn">M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M16,16 L22,22 M10,6 V14 M6,10 H14</Geometry>
  <Geometry x:Key="GalapagOS.Icon.ZoomOut">M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M16,16 L22,22 M6,10 H14</Geometry>
  <Geometry x:Key="GalapagOS.Icon.Checkmark">M3,12 L8,17 L21,4</Geometry>
  <Geometry x:Key="GalapagOS.Icon.Arrow">M3,9 H14 V4 L22,12 L14,20 V15 H3 Z</Geometry>
  <Geometry x:Key="GalapagOS.Icon.Goalpost">M4,21 V3 H18 V21 M4,8 H18</Geometry>

  <Style x:Key="GalapagOS.Icon.Path" TargetType="Path">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource GalapagOS.Window.HeaderForeground}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
  </Style>

  <LinearGradientBrush x:Key="GalapagOS.Window.CloseBackground" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#FFDCE7A0" Offset="0"/>
    <GradientStop Color="#FFB5C663" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="GalapagOS.Window.CloseIcon" Color="#FF372C15"/>
  <SolidColorBrush x:Key="GalapagOS.Window.CloseIconStroke" Color="#FFFCEEC0"/>

  <!-- Approved GalapagOS control library: action buttons and metric rows. -->
  <SolidColorBrush x:Key="GalapagOS.Button.Primary.Background" Color="#FF84A340"/>
  <SolidColorBrush x:Key="GalapagOS.Button.Primary.Highlight" Color="#FFC5D370"/>
  <SolidColorBrush x:Key="GalapagOS.Button.Primary.Foreground" Color="#FFFCEEC0"/>
  <SolidColorBrush x:Key="GalapagOS.Button.Secondary.Background" Color="#FFFAF0D6"/>
  <SolidColorBrush x:Key="GalapagOS.Button.Secondary.Highlight" Color="#FFFFF9E8"/>
  <SolidColorBrush x:Key="GalapagOS.Button.Secondary.Foreground" Color="#FF372C15"/>

  <ControlTemplate x:Key="GalapagOS_PrimaryActionButtonTemplate" TargetType="Button">
    <Border x:Name="ButtonSurface"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="6">
      <Grid>
        <Border BorderBrush="{DynamicResource GalapagOS.Window.BorderBrush}"
                BorderThickness="0,0,0,1"
                Margin="0"
                CornerRadius="0,0,5,5"
                IsHitTestVisible="False"/>
        <Grid x:Name="ButtonContentGrid"
              Margin="{TemplateBinding Padding}"
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ContentPresenter x:Name="ButtonContentPresenter"
                            Grid.Column="0"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextElement.FontFamily="{TemplateBinding FontFamily}"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.FontWeight="{TemplateBinding FontWeight}"
                            TextElement.Foreground="{TemplateBinding Foreground}"/>
          <Image x:Name="ButtonIcon"
                 Grid.Column="1"
                 Width="18"
                 Height="18"
                 Margin="6,0,0,0"
                 Stretch="Uniform"
                 VerticalAlignment="Center"
                 Source="{Binding (game:GalapagOSButton.IconSource), RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <DataTrigger Binding="{Binding (game:GalapagOSButton.IconSource), RelativeSource={RelativeSource TemplatedParent}}"
                   Value="{x:Null}">
        <Setter TargetName="ButtonIcon" Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding (game:GalapagOSButton.IconBefore), RelativeSource={RelativeSource TemplatedParent}}"
                   Value="True">
        <Setter TargetName="ButtonContentPresenter" Property="Grid.Column" Value="1"/>
        <Setter TargetName="ButtonIcon" Property="Grid.Column" Value="0"/>
        <Setter TargetName="ButtonIcon" Property="Margin" Value="0,0,6,0"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                   Value="{x:Null}">
        <Setter TargetName="ButtonIcon" Property="Margin" Value="0"/>
      </DataTrigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.9"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.76"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="GalapagOS_SecondaryActionButtonTemplate" TargetType="Button">
    <Border x:Name="ButtonSurface"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="6">
      <Grid>
        <Border BorderBrush="{DynamicResource GalapagOS.Button.Secondary.Highlight}"
                BorderThickness="1,1,1,0"
                CornerRadius="5"
                IsHitTestVisible="False"/>
        <ContentPresenter Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                          Margin="{TemplateBinding Padding}"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                          TextElement.FontSize="{TemplateBinding FontSize}"
                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                          TextElement.Foreground="{TemplateBinding Foreground}"/>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.9"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.76"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="GalapagOS.Button.Primary" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Background" Value="{DynamicResource GalapagOS.Button.Primary.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource GalapagOS.Button.Primary.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GalapagOS.Window.BorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,2"/>
    <Setter Property="Padding" Value="16,9"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="FontFamily" Value="{DynamicResource GalapagOS.FontFamily.Primary}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template" Value="{StaticResource GalapagOS_PrimaryActionButtonTemplate}"/>
  </Style>

  <Style x:Key="GalapagOS.Button.Secondary" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Background" Value="{DynamicResource GalapagOS.Button.Secondary.Background}"/>
    <Setter Property="Foreground" Value="{DynamicResource GalapagOS.Button.Secondary.Foreground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GalapagOS.Window.BorderBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Padding" Value="16,9"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="FontFamily" Value="{DynamicResource GalapagOS.FontFamily.Primary}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template" Value="{StaticResource GalapagOS_SecondaryActionButtonTemplate}"/>
  </Style>

  <ControlTemplate x:Key="GalapagOS_DesktopIconTemplate" TargetType="Button">
    <Border x:Name="IconSelectionSurface"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            CornerRadius="6"
            Padding="{TemplateBinding Padding}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <Image x:Name="DesktopIconImage"
               Source="{Binding (game:GalapagOSButton.IconSource), RelativeSource={RelativeSource TemplatedParent}}"
               Width="56"
               Height="56"
               Stretch="Uniform"
               HorizontalAlignment="Center" />
        <TextBlock x:Name="DesktopIconLabel"
                   Text="{TemplateBinding Content}"
                   Width="104"
                   Margin="0,6,0,0"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontFamily="{TemplateBinding FontFamily}"
                   FontSize="{TemplateBinding FontSize}"
                   FontWeight="{TemplateBinding FontWeight}"
                   Foreground="{TemplateBinding Foreground}" />
      </StackPanel>
    </Border>
    <ControlTemplate.Triggers>
      <DataTrigger Binding="{Binding (game:GalapagOSButton.IconSource), RelativeSource={RelativeSource TemplatedParent}}"
                   Value="{x:Null}">
        <Setter TargetName="DesktopIconImage" Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="IconSelectionSurface" Property="Background" Value="#26FFFFFF"/>
        <Setter TargetName="IconSelectionSurface" Property="BorderBrush" Value="{DynamicResource Chrono_Olive}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="IconSelectionSurface" Property="Background" Value="#4CFFFFFF"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="IconSelectionSurface" Property="Opacity" Value="0.45"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="GalapagOS.DesktopIcon" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Chrono_TreeBark}"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Width" Value="116"/>
    <Setter Property="Height" Value="108"/>
    <Setter Property="FontFamily" Value="{DynamicResource GalapagOS.FontFamily.Primary}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template" Value="{StaticResource GalapagOS_DesktopIconTemplate}"/>
  </Style>

  <ControlTemplate x:Key="GalapagOS_StartMenuAppTemplate" TargetType="Button">
    <Border x:Name="StartMenuAppSurface"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="6">
      <Grid Margin="{TemplateBinding Padding}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="40"
                Height="40"
                Background="{DynamicResource Chrono_VanillaCream}"
                BorderBrush="{DynamicResource GalapagOS.Window.BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                VerticalAlignment="Center">
          <Image x:Name="StartMenuAppIcon"
                 Source="{Binding (game:GalapagOSButton.IconSource), RelativeSource={RelativeSource TemplatedParent}}"
                 Width="34"
                 Height="34"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
        </Border>
        <TextBlock Grid.Column="1"
                   Text="{TemplateBinding Content}"
                   Margin="8,0,4,0"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   FontFamily="{TemplateBinding FontFamily}"
                   FontSize="{TemplateBinding FontSize}"
                   FontWeight="{TemplateBinding FontWeight}"
                   Foreground="{TemplateBinding Foreground}" />
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <DataTrigger Binding="{Binding (game:GalapagOSButton.IconSource), RelativeSource={RelativeSource TemplatedParent}}"
                   Value="{x:Null}">
        <Setter TargetName="StartMenuAppIcon" Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="StartMenuAppSurface" Property="Background" Value="#2684A340" />
        <Setter TargetName="StartMenuAppSurface" Property="BorderBrush" Value="{DynamicResource Chrono_Olive}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="StartMenuAppSurface" Property="Background" Value="#4C84A340" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="StartMenuAppSurface" Property="Opacity" Value="0.45" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="GalapagOS.StartMenuApp" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Chrono_TreeBark}" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Width" Value="246" />
    <Setter Property="Height" Value="60" />
    <Setter Property="FontFamily" Value="{DynamicResource GalapagOS.FontFamily.Primary}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template" Value="{StaticResource GalapagOS_StartMenuAppTemplate}" />
  </Style>

  <ControlTemplate x:Key="GalapagOS_TaskbarButtonTemplate" TargetType="Button">
    <Border x:Name="TaskbarButtonSurface"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="6">
      <ContentPresenter Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentStringFormat="{TemplateBinding ContentStringFormat}"
                        Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        TextElement.FontFamily="{TemplateBinding FontFamily}"
                        TextElement.FontSize="{TemplateBinding FontSize}"
                        TextElement.FontWeight="{TemplateBinding FontWeight}"
                        TextElement.Foreground="{TemplateBinding Foreground}" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="TaskbarButtonSurface" Property="Background" Value="#2684A340" />
        <Setter TargetName="TaskbarButtonSurface" Property="BorderBrush" Value="{DynamicResource Chrono_Olive}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="TaskbarButtonSurface" Property="Background" Value="#4C84A340" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="TaskbarButtonSurface" Property="Opacity" Value="0.45" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="GalapagOS.TaskbarButton" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Chrono_TreeBark}" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="FontFamily" Value="{DynamicResource GalapagOS.FontFamily.Primary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template" Value="{StaticResource GalapagOS_TaskbarButtonTemplate}" />
  </Style>

  <ControlTemplate x:Key="GalapagOS_DismissLayerTemplate" TargetType="Button">
    <Border Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" />
  </ControlTemplate>

  <Style x:Key="GalapagOS.DismissLayer" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template" Value="{StaticResource GalapagOS_DismissLayerTemplate}" />
  </Style>

  <ControlTemplate x:Key="GalapagOS_MetricStatRowTemplate" TargetType="ContentControl">
    <Grid MinHeight="34">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Image x:Name="MetricIcon"
             Source="{Binding (game:GalapagOSMetricRow.IconSource), RelativeSource={RelativeSource TemplatedParent}}"
             Width="32"
             Height="32"
             Stretch="Uniform"
             VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1"
                 Text="{Binding (game:GalapagOSMetricRow.Label), RelativeSource={RelativeSource TemplatedParent}}"
                 VerticalAlignment="Center"
                 FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                 FontSize="16"
                 Foreground="{TemplateBinding Foreground}"/>
      <TextBlock Grid.Column="2"
                 Text="{Binding (game:GalapagOSMetricRow.Value), RelativeSource={RelativeSource TemplatedParent}}"
                 Margin="20,0,0,0"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Right"
                 FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                 FontSize="16"
                 FontWeight="Bold"
                 Foreground="{TemplateBinding Foreground}"/>
    </Grid>
    <ControlTemplate.Triggers>
      <DataTrigger Binding="{Binding (game:GalapagOSMetricRow.IconSource), RelativeSource={RelativeSource TemplatedParent}}"
                   Value="{x:Null}">
        <Setter TargetName="MetricIcon" Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="GalapagOS.MetricStatRow" TargetType="ContentControl">
    <Setter Property="Foreground" Value="{DynamicResource Chrono_TreeBark}"/>
    <Setter Property="Template" Value="{StaticResource GalapagOS_MetricStatRowTemplate}"/>
  </Style>

  <LinearGradientBrush x:Key="GalapagOS.Progress.Highlight" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#FF91AA50" Offset="0" />
    <GradientStop Color="#FF91AA50" Offset="0.55" />
    <GradientStop Color="#FFB8CA6B" Offset="0.66" />
    <GradientStop Color="#FFE5EDAD" Offset="0.76" />
    <GradientStop Color="#FFF3F6C8" Offset="0.84" />
    <GradientStop Color="#FFF3F6C8" Offset="1" />
  </LinearGradientBrush>

  <ControlTemplate x:Key="GalapagOS_ProgressBarTemplate" TargetType="ProgressBar">
    <Grid x:Name="ProgressTemplateRoot" MinHeight="24">
      <Border x:Name="PART_Track"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="8">
        <Grid>
          <Border x:Name="PART_Indicator"
                  Background="{TemplateBinding Foreground}"
                  HorizontalAlignment="Left"
                  CornerRadius="7,0,0,7">
            <Border x:Name="IndicatorHighlight"
                    Height="3"
                    Margin="2,0,0,0"
                    VerticalAlignment="Top"
                    Background="{DynamicResource GalapagOS.Progress.Highlight}"
                    CornerRadius="3,0,0,3" />
          </Border>
        </Grid>
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.45" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="GalapagOS.ProgressBar" TargetType="ProgressBar">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Background" Value="{DynamicResource Chrono_VanillaCream}"/>
    <Setter Property="Foreground" Value="{DynamicResource Chrono_Olive}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GalapagOS.Window.BorderBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Template" Value="{StaticResource GalapagOS_ProgressBarTemplate}"/>
  </Style>

  <ControlTemplate x:Key="GalapagOS_CloseWindowButtonTemplate" TargetType="Button">
    <Border x:Name="CloseButtonBackground" Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="2">
      <Grid Width="32" Height="32">
        <Path Data="M1,-6 -2,-3 8,7 -2,17 1,20 11,10 21,20 24,17 14,7 24,-3 21,-6 11,4z"
              Width="27" Height="27" HorizontalAlignment="Center" VerticalAlignment="Center"
              Stretch="Fill" Fill="{TemplateBinding Foreground}"
              Stroke="{DynamicResource GalapagOS.Window.CloseIconStroke}"
              StrokeThickness="2" StrokeLineJoin="Round"/>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="CloseButtonBackground" Property="Opacity" Value="0.88"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="CloseButtonBackground" Property="Opacity" Value="0.62"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="GalapagOS_HeaderedWindowStyle" TargetType="HeaderedContentControl">
    <Setter Property="Background" Value="{DynamicResource GalapagOS.Window.BodyBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GalapagOS.Window.BorderBrush}"/>
    <Setter Property="BorderThickness" Value="4"/>
    <Setter Property="Foreground" Value="{DynamicResource GalapagOS.Window.HeaderForeground}"/>
    <Setter Property="Padding" Value="16"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <Border Background="{DynamicResource GalapagOS.Window.HeaderBackground}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6">
            <b:Interaction.Behaviors>
              <game:GalapagOSWindowDragBehavior />
            </b:Interaction.Behaviors>
            <Grid>
              <Border Height="36" VerticalAlignment="Top"
                      Background="{DynamicResource GalapagOS.Window.HeaderBackground}"
                      BorderBrush="{DynamicResource GalapagOS.Window.BorderBrush}"
                      BorderThickness="0,0,0,1"
                      CornerRadius="6,6,0,0">
                <Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="3"
                            Background="{DynamicResource GalapagOS.Brush.TopStripes}"
                            IsHitTestVisible="False" />
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left">
                      <Image x:Name="HeaderIcon"
                             Source="{Binding (game:GalapagOSWindow.IconSource), RelativeSource={RelativeSource TemplatedParent}}"
                             Width="30" Height="30" Margin="0,0,6,0"
                             Stretch="Uniform" VerticalAlignment="Center"/>
                      <ContentPresenter Content="{TemplateBinding Header}"
                                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                                        ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                        VerticalAlignment="Center"
                                        TextElement.FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                                        TextElement.FontSize="24"
                                        TextElement.FontWeight="Bold"
                                        TextElement.Foreground="{DynamicResource GalapagOS.Window.HeaderForeground}"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Width="32" Height="32" HorizontalAlignment="Right"
                            Background="{DynamicResource GalapagOS.Window.CloseBackground}"
                            BorderBrush="{DynamicResource GalapagOS.Window.CloseIconStroke}"
                            BorderThickness="1"
                            Padding="0"
                            Margin="4,0"
                            Foreground="{DynamicResource GalapagOS.Window.CloseIcon}"
                            Template="{StaticResource GalapagOS_CloseWindowButtonTemplate}"
                            Command="{Binding (game:GalapagOSWindow.CloseCommand), RelativeSource={RelativeSource TemplatedParent}}"
                            IsEnabled="{Binding (game:GalapagOSWindow.CloseEnabled), RelativeSource={RelativeSource TemplatedParent}}"
                            IsTabStop="False"/>
                  </Grid>
                </Grid>
              </Border>
              <Border Margin="4,36,4,4"
                      Background="{TemplateBinding Background}"
                      CornerRadius="0,0,4,4"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding (game:GalapagOSWindow.IconSource), RelativeSource={RelativeSource TemplatedParent}}"
                         Value="{x:Null}">
              <Setter TargetName="HeaderIcon" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="GalapagOS_CloseWindowButtonStyle" TargetType="Button">
    <Border x:Name="BackgroundBorder" Padding="{TemplateBinding Padding}" CornerRadius="4,4,4,4">
      <Border.Background>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="1">
          <GradientStop Offset="0" Color="#FFA9AA5A"/>
          <GradientStop Offset="1" Color="#FFEDFFA0"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid x:Name="IconContainerGrid" Width="32">
        <Path x:Name="XPath" RenderTransformOrigin="-0.0137143,0.00959977" Data="M1,-6 -2,-3 8,7 -2,17 1,20 11,10 21,20 24,17 14,7 24,-3 21,-6 11,4z" Stretch="Fill" Width="26.999998" Height="26.999998" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FFCCFFA3" Stroke="#FF758F60" StrokeThickness="2" StrokeLineJoin="Round" StrokeMiterLimit="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashArray="0" StrokeDashCap="Round" StrokeDashOffset="1">
          <Path.RenderTransform>
            <TransformGroup>
              <ScaleTransform/>
              <SkewTransform/>
              <RotateTransform/>
              <TranslateTransform/>
            </TransformGroup>
          </Path.RenderTransform>
        </Path>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="BackgroundBorder" Property="Background" Value="#FF778899"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="BackgroundBorder" Property="Background" Value="#FF708090"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  
  <Style x:Key="GalapagOS_WindowStyle" TargetType="ContentControl">
    <Style.Setters>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContentControl">
            <Grid x:Name="GalapagOS_Window">
              <Border x:Name="Window_Root_Border" Width="500" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource Chrono_VanillaCream}" BorderBrush="#FF000000" CornerRadius="6,6,6,6">
                <Grid x:Name="WindowContentGrid">
                  <Grid.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.5">
                      <GradientStop Color="#FFF3FFB6" Offset="0.88100004"/>
                      <GradientStop Offset="1" Color="#FFCCE43E"/>
                    </LinearGradientBrush>
                  </Grid.Background>
                  <Border x:Name="HeaderBorderContainer" Height="32" VerticalAlignment="Top" Background="#FFDFE99A" CornerRadius="8,8,0,0">
                    <Grid x:Name="HeaderContentGrid">
                      <Grid x:Name="StripeGridContainer">
                        <Rectangle x:Name="Stripe1" Height="2" Margin="0,8,0,0" VerticalAlignment="Top" Fill="{DynamicResource Chrono_Lime}"/>
                        <Rectangle x:Name="Stripe2" Height="2" Margin="0,16,0,0" VerticalAlignment="Top" Fill="{DynamicResource Chrono_Lime}"/>
                        <Rectangle x:Name="Stripe3" Height="2" Margin="0,24,0,0" VerticalAlignment="Top" Fill="{DynamicResource Chrono_Lime}"/>
                        <Button x:Name="CloseButton" Content="Button" HorizontalAlignment="Right" Template="{DynamicResource GalapagOS_CloseWindowButtonStyle}"/>
                      </Grid>
                      <Border x:Name="HeaderTextBorder" HorizontalAlignment="Left" CornerRadius="4,2,4,0">
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="1">
                            <GradientStop Offset="0" Color="#FFA9AA5A"/>
                            <GradientStop Offset="1" Color="#FFEDFFA0"/>
                          </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                          <DropShadowEffect Color="#88A9AA5A" BlurRadius="6" Direction="330" ShadowDepth="4"/>
                        </Border.Effect>
                        <TextBlock x:Name="HeaderText" Text="GalapagOS Window" Height="24" Margin="6,0,6,0" Foreground="#FFCCFFA3" Stroke="#FF758F60" StrokeThickness="2" FontSize="20" FontWeight="Bold" TextAlignment="Center"/>
                      </Border>
                    </Grid>
                  </Border>
                  <ContentPresenter x:Name="WindowContentPresenter" Content="{TemplateBinding Content}" Margin="0,32,0,0"/>
                </Grid>
              </Border>
            </Grid>
          </ControlTemplate>  
        </Setter.Value>
      </Setter>    
    </Style.Setters>
  </Style>  
</ResourceDictionary>
