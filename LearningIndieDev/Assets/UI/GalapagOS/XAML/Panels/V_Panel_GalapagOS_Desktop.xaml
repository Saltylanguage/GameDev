                    CommandParameter="Quick Search / Jump" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border x:Name="VolumePanel"
            Visibility="{Binding VolumePanelVisibility}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Width="280"
            Height="154"
            Margin="0,0,354,84"
            Padding="12"
            Background="{DynamicResource Chrono_LightCream}"
            BorderBrush="{DynamicResource GalapagOS.Window.BorderBrush}"
            BorderThickness="3"
            CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="28" />
          <RowDefinition Height="40" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="VOLUME CONTROLS"
                   FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="{DynamicResource Chrono_TreeBark}" />
        <TextBlock Grid.Row="1"
                   Text="{Binding VolumeText}"
                   FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource Chrono_Olive}"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Row="2" Orientation="Horizontal">
          <Button Content="-"
                  Width="52"
                  Style="{StaticResource GalapagOS.Button.Secondary}"
                  Command="{Binding VolumeDownCommand}" />
          <Button Content="Mute"
                  Width="76"
                  Margin="8,0"
                  Style="{StaticResource GalapagOS.Button.Secondary}"
                  Command="{Binding ToggleMuteCommand}" />
          <Button Content="+"
                  Width="52"
                  Style="{StaticResource GalapagOS.Button.Secondary}"
                  Command="{Binding VolumeUpCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="NotificationsPanel"
            Visibility="{Binding NotificationsPanelVisibility}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Width="360"
            Height="218"
            Margin="0,0,148,84"
            Padding="12"
            Background="{DynamicResource Chrono_LightCream}"
            BorderBrush="{DynamicResource GalapagOS.Window.BorderBrush}"
            BorderThickness="3"
            CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="30" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="NOTIFICATIONS · 3 UNREAD"
                   FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="{DynamicResource Chrono_TreeBark}" />
        <Border Grid.Row="1"
                Margin="0,4,0,2"
                Padding="8,4"
                Background="{DynamicResource Chrono_VanillaCream}"
                BorderBrush="{DynamicResource Chrono_Sand}"
                BorderThickness="1"
                CornerRadius="4">
          <TextBlock Text="QUEST READY · Analyze Fernlight samples"
                     FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                     FontSize="11"
                     Foreground="{DynamicResource Chrono_TreeBark}"
                     VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="2"
                Margin="0,2"
                Padding="8,4"
                Background="{DynamicResource Chrono_VanillaCream}"
                BorderBrush="{DynamicResource Chrono_Sand}"
                BorderThickness="1"
                CornerRadius="4">
          <TextBlock Text="LEVEL UP · Field Researcher II"
                     FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                     FontSize="11"
                     Foreground="{DynamicResource Chrono_TreeBark}"
                     VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="3"
                Margin="0,2,0,0"
                Padding="8,4"
                Background="{DynamicResource Chrono_VanillaCream}"
                BorderBrush="{DynamicResource Chrono_Sand}"
                BorderThickness="1"
                CornerRadius="4">
          <TextBlock Text="DATA UPDATE · +120 research data"
                     FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                     FontSize="11"
                     Foreground="{DynamicResource Chrono_TreeBark}"
                     VerticalAlignment="Center" />
        </Border>
      </Grid>
    </Border>

    <Border x:Name="GameSpeedPanel"
            Visibility="{Binding GameSpeedPanelVisibility}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Width="232"
            Height="154"
            Margin="0,0,18,84"
            Padding="12"
            Background="{DynamicResource Chrono_LightCream}"
            BorderBrush="{DynamicResource GalapagOS.Window.BorderBrush}"
            BorderThickness="3"
            CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="30" />
          <RowDefinition Height="34" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="GAME SPEED CONTROLS"
                   FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                   FontSize="13"
                   FontWeight="Bold"
                   Foreground="{DynamicResource Chrono_TreeBark}" />
        <TextBlock Grid.Row="1"
                   Text="Select simulation pace"
                   FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                   FontSize="11"
                   Foreground="{DynamicResource Chrono_Olive}"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Row="2" Orientation="Horizontal">
          <Button Content="0.5x"
                  Width="52"
                  Style="{StaticResource GalapagOS.Button.Secondary}"
                  Command="{Binding SetGameSpeedCommand}"
                  CommandParameter="0.5" />
          <Button Content="1x"
                  Width="44"
                  Margin="6,0"
                  Style="{StaticResource GalapagOS.Button.Secondary}"
                  Command="{Binding SetGameSpeedCommand}"
                  CommandParameter="1" />
          <Button Content="2x"
                  Width="44"
                  Style="{StaticResource GalapagOS.Button.Secondary}"
                  Command="{Binding SetGameSpeedCommand}"
                  CommandParameter="2" />
          <Button Content="4x"
                  Width="44"
                  Margin="6,0,0,0"
                  Style="{StaticResource GalapagOS.Button.Secondary}"
                  Command="{Binding SetGameSpeedCommand}"
                  CommandParameter="4" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Page>
