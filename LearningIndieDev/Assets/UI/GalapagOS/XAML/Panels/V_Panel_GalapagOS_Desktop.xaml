<Page x:Name="Panel_Root"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DesignWidth="1920"
  d:DesignHeight="1080"
  Background="#FF4D5052"
  Foreground="#FFE1E9ED">
  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../../GlobalResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Page.Resources>
  <Border x:Name="Root_Border">
    <Grid x:Name="ContentGrid" Background="{DynamicResource Salty_SoftGreen}">
<Grid x:Name="GalapagOS_Window">
              <Border x:Name="Window_Root_Border" Width="500" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource Chrono_VanillaCream}" BorderBrush="#FF000000" CornerRadius="6,6,6,6">
                <Grid x:Name="WindowContentGrid">
                  <Grid.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="0.5">
                      <GradientStop Color="#FFF3FFB6" Offset="0.88100004"/>
                      <GradientStop Offset="1" Color="#FFCCE43E"/>
                    </LinearGradientBrush>
                  </Grid.Background>
                  <Border x:Name="HeaderBorderContainer" Height="32" VerticalAlignment="Top" Background="#FFDFE99A" CornerRadius="8,8,0,0">
                    <Grid x:Name="HeaderContentGrid">
                      <Grid x:Name="StripeGridContainer">
                        <Rectangle x:Name="Stripe1" Height="2" Margin="0,8,0,0" VerticalAlignment="Top" Fill="{DynamicResource Chrono_Lime}"/>
                        <Rectangle x:Name="Stripe2" Height="2" Margin="0,16,0,0" VerticalAlignment="Top" Fill="{DynamicResource Chrono_Lime}"/>
                        <Rectangle x:Name="Stripe3" Height="2" Margin="0,24,0,0" VerticalAlignment="Top" Fill="{DynamicResource Chrono_Lime}"/>
                        <Button x:Name="CloseButton" Content="Button" HorizontalAlignment="Right" Template="{DynamicResource GalapagOS_CloseWindowButtonStyle}"/>
                      </Grid>
                      <Border x:Name="HeaderTextBorder" HorizontalAlignment="Left" CornerRadius="4,2,4,0">
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="1">
                            <GradientStop Offset="0" Color="#FFA9AA5A"/>
                            <GradientStop Offset="1" Color="#FFEDFFA0"/>
                          </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                          <DropShadowEffect Color="#88A9AA5A" BlurRadius="6" Direction="330" ShadowDepth="4"/>
                        </Border.Effect>
                        <TextBlock x:Name="HeaderText" Text="GalapagOS Window" Height="24" Margin="6,0,6,0" Foreground="#FFCCFFA3" Stroke="#FF758F60" StrokeThickness="2" FontSize="20" FontWeight="Bold" TextAlignment="Center"/>
                      </Border>
                    </Grid>
                  </Border>
                </Grid>
              </Border>
              </Grid>
              </Grid>
              </Border>

</Page>
