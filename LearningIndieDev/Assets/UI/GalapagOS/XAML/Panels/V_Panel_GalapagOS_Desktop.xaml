                          Padding="9">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="1  QUICK FEET"
                                   FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Chrono_TreeBark}" />
                        <TextBlock Text="MOVEMENT · NEW STARTING CHOICE"
                                   Margin="0,3,0,0"
                                   FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                   FontSize="10"
                                   Foreground="{DynamicResource Chrono_TreeBark}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 Text="AVAILABLE"
                                 Margin="8,0,0,0"
                                 FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                 FontSize="10"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource Chrono_Olive}"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                  <Border Background="{DynamicResource Chrono_LightCream}"
                          BorderBrush="{DynamicResource Chrono_Sand}"
                          BorderThickness="2"
                          CornerRadius="6"
                          Padding="9"
                          Margin="0,7,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="2  ALERT EARS"
                                   FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Chrono_TreeBark}" />
                        <TextBlock Text="PERCEPTION · REQUIRES QUICK FEET"
                                   Margin="0,3,0,0"
                                   FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                   FontSize="10"
                                   Foreground="{DynamicResource Chrono_TreeBark}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 Text="LOCKED"
                                 Margin="8,0,0,0"
                                 FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                 FontSize="10"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource Chrono_TreeBark}"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                  <Border Background="{DynamicResource Chrono_LightCream}"
                          BorderBrush="{DynamicResource Chrono_Sand}"
                          BorderThickness="2"
                          CornerRadius="6"
                          Padding="9"
                          Margin="0,7,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="3  DENSE FUR"
                                   FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Chrono_TreeBark}" />
                        <TextBlock Text="SURVIVAL · REQUIRES ALERT EARS"
                                   Margin="0,3,0,0"
                                   FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                   FontSize="10"
                                   Foreground="{DynamicResource Chrono_TreeBark}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 Text="LOCKED"
                                 Margin="8,0,0,0"
                                 FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                                 FontSize="10"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource Chrono_TreeBark}"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource Chrono_LightCream}"
                    BorderBrush="{DynamicResource Chrono_Sand}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="12">
              <StackPanel>
                <TextBlock Text="SELECTED NODE"
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Chrono_Olive}" />
                <TextBlock Text="QUICK FEET"
                           Margin="0,10,0,0"
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Chrono_TreeBark}" />
                <TextBlock Text="PERMANENT UNLOCK"
                           Margin="0,3,0,0"
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Chrono_Olive}" />
                <Rectangle Height="1"
                           Margin="0,10,0,10"
                           Fill="Transparent"
                           Stroke="{DynamicResource Chrono_Sand}"
                           StrokeDashArray="6,4"
                           StrokeThickness="1" />
                <TextBlock Text="Adds a movement-focused starting choice to the Expedition Planner."
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                           FontSize="12"
                           Foreground="{DynamicResource Chrono_TreeBark}"
                           TextWrapping="Wrap" />
                <TextBlock Text="COST  ·  180 HERBIVORE DATA"
                           Margin="0,12,0,0"
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Chrono_TreeBark}"
                           TextWrapping="Wrap" />
                <Button Content="PREVIEW IN EXPEDITION SETUP"
                        Height="34"
                        Margin="0,12,0,0"
                        IsEnabled="False"
                        Style="{StaticResource GalapagOS.Button.Secondary}" />
                <TextBlock Text="Preview only · Gene Lab actions will be wired in the feature pass."
                           Margin="0,8,0,0"
                           FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                           FontSize="10"
                           Foreground="{DynamicResource Chrono_TreeBark}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Grid.Row="3"
                  Background="{DynamicResource Chrono_Lime}"
                  BorderBrush="{DynamicResource GalapagOS.Window.BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="PERMANENT RESEARCH  ·  FUTURE EXPEDITIONS"
                         FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                         FontSize="10"
                         FontWeight="Bold"
                         Foreground="{DynamicResource Chrono_TreeBark}" />
              <TextBlock Grid.Column="1"
                         Text="TEMPORARY REWARDS STAY IN SIMULATION"
                         Margin="10,0,0,0"
                         FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                         FontSize="9"
                         FontWeight="Bold"
                         Foreground="{DynamicResource Chrono_Olive}"
                         TextWrapping="Wrap"
                         HorizontalAlignment="Right" />
            </Grid>
          </Border>
        </Grid>

        <StackPanel Grid.Row="0"
                    Visibility="{Binding GenericDesktopAppVisibility}">
          <TextBlock Text="GALAPAGOS DESKTOP APPLICATION"
                     FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                     FontSize="18"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Chrono_TreeBark}" />
          <TextBlock Text="A new workspace is taking shape."
                     Margin="0,6,0,0"
                     FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                     FontSize="14"
                     Foreground="{DynamicResource Chrono_TreeBark}" />
        </StackPanel>

        <Rectangle Grid.Row="1"
                   Visibility="{Binding GenericDesktopAppVisibility}"
                   Margin="0,16,0,16"
                   Height="1"
                   Fill="Transparent"
                   Stroke="{DynamicResource Chrono_Sand}"
                   StrokeDashArray="8,5"
                   StrokeThickness="3"
                   Opacity="0.85" />

        <Border Grid.Row="2"
                Visibility="{Binding GenericDesktopAppVisibility}"
                Background="{DynamicResource Chrono_LightCream}"
                BorderBrush="{DynamicResource Chrono_Sand}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="28">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding ActiveDesktopAppDescription}"
                       FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                       FontSize="20"
                       Foreground="{DynamicResource Chrono_TreeBark}"
                       TextWrapping="Wrap" />
            <TextBlock Text="FEATURE SURFACE READY"
                       Margin="0,24,0,0"
                       FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Chrono_Olive}" />
            <TextBlock Text="The detailed controls for this application will be added in its feature pass."
                       Margin="0,8,0,0"
                       FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                       FontSize="14"
                       Foreground="{DynamicResource Chrono_TreeBark}"
                       TextWrapping="Wrap" />
            <Button Content="Close"
                    Width="140"
                    Margin="0,28,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding CloseDesktopAppCommand}"
                    Style="{StaticResource GalapagOS.Button.Secondary}" />
          </StackPanel>
        </Border>
      </Grid>
    </HeaderedContentControl>

    <Button x:Name="StartMenuDismissLayer"
            Visibility="{Binding StartMenuVisibility}"
            Panel.ZIndex="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Margin="0,0,0,76"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            Command="{Binding CloseStartMenuCommand}"
            Focusable="False"
            IsTabStop="False"
            Style="{StaticResource GalapagOS.DismissLayer}" />

    <Border x:Name="StartMenu"
            Visibility="{Binding StartMenuVisibility}"
            Panel.ZIndex="30"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Width="560"
            Height="660"
            Margin="18,0,0,84"
            Padding="16"
            Background="{DynamicResource Chrono_LightCream}"
            BorderBrush="{DynamicResource GalapagOS.Window.BorderBrush}"
            BorderThickness="3"
            CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="72" />
          <RowDefinition Height="34" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <Image Source="../../Art/Icons/GalapagOS_Icon_Sprout.png"
                 Width="48"
                 Height="48"
                 Margin="0,0,12,0"
                 Stretch="Uniform" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="GALAPAGOS APPS"
                       FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Chrono_TreeBark}" />
            <TextBlock Text="FIELD STATION MENU"
                       FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                       FontSize="12"
                       Foreground="{DynamicResource Chrono_Olive}" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Row="1"
                Margin="0,4,0,0"
                Padding="0,0,0,6"
                BorderBrush="{DynamicResource Chrono_Sand}"
                BorderThickness="0,0,0,1">
          <TextBlock Text="14 AVAILABLE APPS · SELECT TO OPEN"
                     FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                     FontSize="13"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Chrono_Olive}"
                     VerticalAlignment="Center" />
        </Border>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <Button Content="Field Notes"
                    Margin="0,0,6,4"
                    Style="{StaticResource GalapagOS.StartMenuApp}"
                    game:GalapagOSButton.IconSource="../../Art/Icons/GalapagOS_Icon_Clipboard.png"
                    Command="{Binding OpenDesktopIconCommand}"
                    CommandParameter="Field Notes" />
            <Button Content="My Collection"
                    Margin="0,0,6,4"
                    Style="{StaticResource GalapagOS.StartMenuApp}"
                    game:GalapagOSButton.IconSource="../../Art/Icons/GalapagOS_Icon_FlowerPurple.png"
                    Command="{Binding OpenDesktopIconCommand}"
                    CommandParameter="My Collection" />
            <Button Content="Gene Lab"
                    Margin="0,0,6,4"
                    Style="{StaticResource GalapagOS.StartMenuApp}"
                    game:GalapagOSButton.IconSource="../../Art/Icons/GalapagOS_Icon_Flask.png"
                    Command="{Binding OpenDesktopIconCommand}"
                    CommandParameter="Gene Lab" />
            <Button Content="My PC"
                    Margin="0,0,6,4"
                    Style="{StaticResource GalapagOS.StartMenuApp}"
                    game:GalapagOSButton.IconSource="../../Art/Icons/GalapagOS_Icon_Clipboard.png"
                    Command="{Binding OpenDesktopIconCommand}"
                    CommandParameter="My PC" />
            <Button Content="History / Data Record"
                    Margin="0,0,6,4"
                    Style="{StaticResource GalapagOS.StartMenuApp}"
                    game:GalapagOSButton.IconSource="../../Art/Icons/GalapagOS_Icon_CrystalBlue.png"
                    Command="{Binding OpenDesktopIconCommand}"
                    CommandParameter="History / Data Record" />
            <Button Content="Biome Data"
                    Margin="0,0,6,0"
                    Style="{StaticResource GalapagOS.StartMenuApp}"
                    game:GalapagOSButton.IconSource="../../Art/Icons/GalapagOS_Icon_Sprout.png"
                    Command="{Binding OpenDesktopIconCommand}"
                    CommandParameter="Biome Data" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <Button Content="Simulation"
                    Margin="0,0,0,4"
                    Style="{StaticResource GalapagOS.StartMenuApp}"
                    game:GalapagOSButton.IconSource="../../Art/Icons/GalapagOS_Icon_CrystalBlue.png"
                    Command="{Binding OpenDesktopIconCommand}"
                    CommandParameter="Simulation" />
            <Button Content="Music Player"
                    Margin="0,0,0,4"
                    Style="{StaticResource GalapagOS.StartMenuApp}"
                    game:GalapagOSButton.IconSource="../../Art/Icons/GalapagOS_Icon_CrystalBlue.png"
                    Command="{Binding OpenDesktopIconCommand}"
                    CommandParameter="Music Player" />
            <Button Content="Expedition Planner"
                    Margin="0,0,0,4"
                    Style="{StaticResource GalapagOS.StartMenuApp}"
                    game:GalapagOSButton.IconSource="../../Art/Icons/GalapagOS_Icon_FlowerPurple.png"
                    Command="{Binding OpenDesktopIconCommand}"
                    CommandParameter="Expedition Planner / Launchpad" />
            <Button Content="Field Guide"
                    Margin="0,0,0,4"
                    Style="{StaticResource GalapagOS.StartMenuApp}"
                    game:GalapagOSButton.IconSource="../../Art/Icons/GalapagOS_Icon_Clipboard.png"
                    Command="{Binding OpenDesktopIconCommand}"
                    CommandParameter="Field Guide / Journal" />
            <Button Content="Research Inbox"
                    Margin="0,0,0,4"
                    Style="{StaticResource GalapagOS.StartMenuApp}"
                    game:GalapagOSButton.IconSource="../../Art/Icons/GalapagOS_Icon_Flask.png"
                    Command="{Binding OpenDesktopIconCommand}"
                    CommandParameter="Research Inbox / Bulletin" />
            <Button Content="Habitat Gallery"
                    Margin="0,0,0,4"
                    Style="{StaticResource GalapagOS.StartMenuApp}"
                    game:GalapagOSButton.IconSource="../../Art/Icons/GalapagOS_Icon_FlowerPurple.png"
                    Command="{Binding OpenDesktopIconCommand}"
                    CommandParameter="Habitat Gallery / Museum" />
            <Button Content="Settings"
                    Margin="0,0,0,4"
                    Style="{StaticResource GalapagOS.StartMenuApp}"
                    game:GalapagOSButton.IconSource="../../Art/Icons/GalapagOS_Icon_Clipboard.png"
                    Command="{Binding OpenDesktopIconCommand}"
                    CommandParameter="Settings" />
            <Button Content="Quick Search / Jump"
                    Margin="0,0,0,0"
                    Style="{StaticResource GalapagOS.StartMenuApp}"
                    game:GalapagOSButton.IconSource="../../Art/Icons/GalapagOS_Icon_CrystalBlue.png"
                    Command="{Binding OpenDesktopIconCommand}"
                    CommandParameter="Quick Search / Jump" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <Border x:Name="VolumePanel"
            Visibility="{Binding VolumePanelVisibility}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Width="280"
            Height="154"
            Margin="0,0,354,84"
            Padding="12"
            Background="{DynamicResource Chrono_LightCream}"
            BorderBrush="{DynamicResource GalapagOS.Window.BorderBrush}"
            BorderThickness="3"
            CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="28" />
          <RowDefinition Height="40" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="VOLUME CONTROLS"
                   FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="{DynamicResource Chrono_TreeBark}" />
        <TextBlock Grid.Row="1"
                   Text="{Binding VolumeText}"
                   FontFamily="{DynamicResource GalapagOS.FontFamily.Monospace}"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource Chrono_Olive}"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Row="2" Orientation="Horizontal">
          <Button Content="-"
                  Width="52"
                  Style="{StaticResource GalapagOS.Button.Secondary}"
                  Command="{Binding VolumeDownCommand}" />
          <Button Content="Mute"
                  Width="76"
                  Margin="8,0"
                  Style="{StaticResource GalapagOS.Button.Secondary}"
                  Command="{Binding ToggleMuteCommand}" />
          <Button Content="+"
                  Width="52"
                  Style="{StaticResource GalapagOS.Button.Secondary}"
                  Command="{Binding VolumeUpCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="NotificationsPanel"
            Visibility="{Binding NotificationsPanelVisibility}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Width="360"
            Height="218"
            Margin="0,0,148,84"
            Padding="12"
            Background="{DynamicResource Chrono_LightCream}"
            BorderBrush="{DynamicResource GalapagOS.Window.BorderBrush}"
            BorderThickness="3"
            CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="30" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="NOTIFICATIONS · 3 UNREAD"
                   FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="{DynamicResource Chrono_TreeBark}" />
        <Border Grid.Row="1"
                Margin="0,4,0,2"
                Padding="8,4"
                Background="{DynamicResource Chrono_VanillaCream}"
                BorderBrush="{DynamicResource Chrono_Sand}"
                BorderThickness="1"
                CornerRadius="4">
          <TextBlock Text="QUEST READY · Analyze Fernlight samples"
                     FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                     FontSize="11"
                     Foreground="{DynamicResource Chrono_TreeBark}"
                     VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="2"
                Margin="0,2"
                Padding="8,4"
                Background="{DynamicResource Chrono_VanillaCream}"
                BorderBrush="{DynamicResource Chrono_Sand}"
                BorderThickness="1"
                CornerRadius="4">
          <TextBlock Text="LEVEL UP · Field Researcher II"
                     FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                     FontSize="11"
                     Foreground="{DynamicResource Chrono_TreeBark}"
                     VerticalAlignment="Center" />
        </Border>
        <Border Grid.Row="3"
                Margin="0,2,0,0"
                Padding="8,4"
                Background="{DynamicResource Chrono_VanillaCream}"
                BorderBrush="{DynamicResource Chrono_Sand}"
                BorderThickness="1"
                CornerRadius="4">
          <TextBlock Text="DATA UPDATE · +120 research data"
                     FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                     FontSize="11"
                     Foreground="{DynamicResource Chrono_TreeBark}"
                     VerticalAlignment="Center" />
        </Border>
      </Grid>
    </Border>

    <Border x:Name="GameSpeedPanel"
            Visibility="{Binding GameSpeedPanelVisibility}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Width="232"
            Height="154"
            Margin="0,0,18,84"
            Padding="12"
            Background="{DynamicResource Chrono_LightCream}"
            BorderBrush="{DynamicResource GalapagOS.Window.BorderBrush}"
            BorderThickness="3"
            CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="30" />
          <RowDefinition Height="34" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="GAME SPEED CONTROLS"
                   FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                   FontSize="13"
                   FontWeight="Bold"
                   Foreground="{DynamicResource Chrono_TreeBark}" />
        <TextBlock Grid.Row="1"
                   Text="Select simulation pace"
                   FontFamily="{DynamicResource GalapagOS.FontFamily.Primary}"
                   FontSize="11"
                   Foreground="{DynamicResource Chrono_Olive}"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Row="2" Orientation="Horizontal">
          <Button Content="0.5x"
                  Width="52"
                  Style="{StaticResource GalapagOS.Button.Secondary}"
                  Command="{Binding SetGameSpeedCommand}"
                  CommandParameter="0.5" />
          <Button Content="1x"
                  Width="44"
                  Margin="6,0"
                  Style="{StaticResource GalapagOS.Button.Secondary}"
                  Command="{Binding SetGameSpeedCommand}"
                  CommandParameter="1" />
          <Button Content="2x"
                  Width="44"
                  Style="{StaticResource GalapagOS.Button.Secondary}"
                  Command="{Binding SetGameSpeedCommand}"
                  CommandParameter="2" />
          <Button Content="4x"
                  Width="44"
                  Margin="6,0,0,0"
                  Style="{StaticResource GalapagOS.Button.Secondary}"
                  Command="{Binding SetGameSpeedCommand}"
                  CommandParameter="4" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
  </Viewbox>
</Page>
