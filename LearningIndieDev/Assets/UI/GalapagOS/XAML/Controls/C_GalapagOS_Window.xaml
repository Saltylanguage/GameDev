<Component
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  HorizontalAlignment="Center" VerticalAlignment="Center"
  TextElement.Foreground="#FFE1E9ED"
  x:Name="GalapagOS_Window" d:DesignWidth="1280" d:DesignHeight="720">
  <Grid x:Name="Root_Grid" Width="500" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="100" MinHeight="100">
    <Border x:Name="Window_BorderContainer" BorderThickness="1" CornerRadius="6,6,6,6">
      <Border.Background>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
          <GradientStop Offset="0.87200004" Color="#FFF8FFD6"/>
          <GradientStop Offset="1" Color="#FFD9E49A"/>
        </LinearGradientBrush>
      </Border.Background>
      <Border x:Name="HeaderBorderContainer" Height="32" VerticalAlignment="Top" Background="#FFDFE99A" CornerRadius="8,8,0,0">
        <Grid x:Name="HeaderContentGrid">
          <Grid x:Name="StripeGridContainer">
            <Rectangle x:Name="Stripe1" Height="2" Margin="0,8,0,0" VerticalAlignment="Top" Fill="{DynamicResource Chrono_Lime}"/>
            <Rectangle x:Name="Stripe2" Height="2" Margin="0,16,0,0" VerticalAlignment="Top" Fill="{DynamicResource Chrono_Lime}"/>
            <Rectangle x:Name="Stripe3" Height="2" Margin="0,24,0,0" VerticalAlignment="Top" Fill="{DynamicResource Chrono_Lime}"/>
          </Grid>
          <Border x:Name="HeaderTextBorder" HorizontalAlignment="Left" CornerRadius="4,4,4,0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1" Opacity="1">
                <GradientStop Offset="0" Color="#FFA9AA5A"/>
                <GradientStop Offset="1" Color="#FFEDFFA0"/>
              </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
              <DropShadowEffect Color="#88A9AA5A" BlurRadius="6" Direction="330" ShadowDepth="4"/>
            </Border.Effect>
            <TextBlock x:Name="HeaderText" Text="Header Text" Height="24" Margin="6,0,6,0" Foreground="#FFCCFFA3" Stroke="#FF758F60" StrokeThickness="2" FontSize="20" FontWeight="Bold" TextAlignment="Center"/>
          </Border>
          <Grid x:Name="HeaderTextContainer" HorizontalAlignment="Left">
            <Grid.Background>
              <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#FFA9AA5A"/>
                <GradientStop Offset="1" Color="#FFEDFFA0"/>
              </LinearGradientBrush>
            </Grid.Background>
          </Grid>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Component>